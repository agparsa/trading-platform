{
  "expo": {
    "name": "gotrade.io",
    "slug": "trading-platform",
    "scheme": "tradingplatform",
    "version": "1.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.devopss.trading",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "ir.devopss.trading",
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE", "CAMERA"],
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "backgroundColor": "#1739A8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of your identity document to send for verification.",
          "cameraPermission": "Photograph your identity document to send for verification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/trade_opened.wav",
            "./assets/sounds/trade_closed.wav",
            "./assets/sounds/trade_modified.wav",
            "./assets/sounds/order_filled.wav",
            "./assets/sounds/order_cancelled.wav",
            "./assets/sounds/stop_loss.wav",
            "./assets/sounds/take_profit.wav",
            "./assets/sounds/risk_warning.wav",
            "./assets/sounds/price_alert.wav"
          ]
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#07090D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://devopss.ir"
    },
    "icon": "./assets/images/icon.png"
  }
}
