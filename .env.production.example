# Production configuration.
#
# Copy to `.env.production`, fill in every value, and keep it out of version
# control. Nothing here has a safe default: every secret below is generated
# once, for this deployment, and a shared one is not a secret.
#
#   pnpm keygen        # prints fresh JWT secrets and an encryption key
#
# Bring the stack up with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ── Identity of this deployment ────────────────────────────────────────────
NODE_ENV=production

# The hostname traders reach. Baked into the web bundle at build time — Next.js
# inlines NEXT_PUBLIC_* — so changing it means rebuilding the web image.
PUBLIC_API_URL=https://trade.example.com/api/v1
PUBLIC_WS_URL=https://trade.example.com

# Which origins may call the API and open a socket. There is no wildcard: with
# this empty, production refuses every cross-origin request rather than falling
# back to allowing all of them.
CORS_ORIGINS=https://trade.example.com

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=
POSTGRES_DB=trading_platform

# ── Secrets ────────────────────────────────────────────────────────────────
# Two different secrets, deliberately. One key signing both token types would
# make a refresh token a valid access token to anything that forgot to check
# `typ` — and the type check is the only thing standing between them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Sealing key for TOTP secrets at rest, from `pnpm keygen`. Rotating it means
# adding the new key at the front of a comma-separated list and leaving the old
# one behind it until everything has been re-sealed; removing the old key before
# then locks every 2FA user out.
SECRET_ENCRYPTION_KEYS=

# ── Market data ────────────────────────────────────────────────────────────
# `internal-simulator` produces plausible prices and is not a market. A real
# deployment implements MarketDataProvider against its venue and sets this to
# the adapter's name; the API refuses to start on a value it has no adapter for,
# which is deliberate — starting with no prices and discovering it when the
# first order is rejected is worse.
MARKET_DATA_PROVIDER=internal-simulator
MARKET_SIMULATOR_TICK_MS=250

# How old a price may be and still be traded on. The engine refuses rather than
# filling against a stale quote; see docs/capacity.md for what makes it stale.
QUOTE_MAX_AGE_MS=5000

# The integrity gate. Generous by design — a broken-feed detector, not a
# liquidity opinion. Zero disables a check. See docs/market-data.md.
MARKET_MAX_SPREAD_RATIO=0.05
MARKET_MAX_JUMP_RATIO=0.1
MARKET_MAX_FUTURE_SKEW_MS=5000
MARKET_REANCHOR_AFTER=5

# ── Engine ─────────────────────────────────────────────────────────────────
TRADING_SERVER_TIMEZONE=UTC
CANDLE_RESOLUTIONS=1,5,15,60,240,1D
REALTIME_VALUATION_INTERVAL_MS=500
STOP_OUT_CHECK_INTERVAL_MS=1000
EXPOSURE_INDEX_REFRESH_MS=30000

# ── Rate limits ────────────────────────────────────────────────────────────
# Per address, and applied in addition to Nginx's. These know which route is
# expensive; Nginx's stop a request before it costs a database connection.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_SOCKET_MESSAGES_PER_MINUTE=100

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Scheduled work ─────────────────────────────────────────────────────────
SWAP_ACCRUAL_CRON=0 0 * * *
RECONCILIATION_CRON=0 * * * *
MAINTENANCE_CRON=30 * * * *
RUN_JOBS_ON_BOOT=false

# ── Email ──────────────────────────────────────────────────────────────────
# `logging` is refused under NODE_ENV=production: a deployment that printed
# password-reset links into its own log instead of delivering them would be a
# security incident, not a convenience. Set `none` to opt out explicitly.
EMAIL_PROVIDER=none

# Used in the links inside verification and reset emails. Must match the
# hostname traders actually reach, or the link in their inbox points somewhere
# that does not exist.
APP_PUBLIC_URL=https://trade.example.com

# ── Accounts ───────────────────────────────────────────────────────────────
# What a new registration opens. The name a trader sees in their authenticator
# app beside their code — make it the one they will recognise.
TOTP_ISSUER=Trading Platform
DEFAULT_ACCOUNT_CURRENCY=USD
DEFAULT_ACCOUNT_LEVERAGE=100
DEMO_ACCOUNT_INITIAL_BALANCE=100000

# ── TLS ────────────────────────────────────────────────────────────────────
# The hostname this deployment answers to. Names the Let's Encrypt certificate
# the Nginx container looks for, and the CN of the self-signed stand-in it
# generates when there is none — so the stack comes up either way, and says
# which of the two happened on every boot.
TLS_DOMAIN=trade.example.com

# A certificate you obtained yourself, if you have one. It wins over anything
# the certbot service issues, because putting a file there is an explicit
# instruction. Leave it pointing at an empty directory to let certbot do it.
TLS_CERT_DIR=./docker/nginx/certs
HTTP_PORT=80
HTTPS_PORT=443

# ── Build ──────────────────────────────────────────────────────────────────
# Where the images fetch Alpine packages from. Empty means Alpine's own CDN,
# which is right nearly everywhere. Set it when that CDN is slow or filtered
# from the network the build runs on — the symptom is `apk add` failing with
# "no such package" for something that plainly exists, because what actually
# failed was fetching the index.
ALPINE_MIRROR=

# ── Who is in front ────────────────────────────────────────────────────────
# Which addresses may set X-Forwarded-For, and therefore decide what every
# per-IP rate limit counts.
#
# The default file trusts nobody and uses the address of whoever connected,
# which is correct when this host faces the internet directly. Behind a CDN it
# is not: every request then arrives from the CDN, so one bucket is shared by
# every user of the platform, and an attacker gets the same allowance as the
# whole legitimate population put together.
#
# `./docker/nginx/trusted-proxies.arvancloud.conf` carries ArvanCloud's
# published ranges. For any other provider, write the equivalent from theirs —
# and never enable `real_ip_header` without naming the sources, which would let
# any client claim any address.
TRUSTED_PROXIES_FILE=./docker/nginx/trusted-proxies.conf
