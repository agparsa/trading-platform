# ---------------------------------------------------------------------------
# Trading Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading:change_me_locally@localhost:5432/trading_platform?schema=public
# Any secret may instead be delivered as a file, e.g. DATABASE_URL_FILE=/run/secrets/database_url
# (docs/secrets.md lists which). Set one or the other, never both.

# The connection tenant traffic uses. Optional, and the single most valuable
# line in this file to set.
#
# Row-level security exempts a table's owner from its own policies, and
# DATABASE_URL is the owner — migrations need it to be. So the policies protect
# every role except the application until this points at a second role that owns
# nothing. `pnpm db:roles` creates that role and prints this line.
#
# Left unset, the API and worker start and say, once, that isolation is not
# enforced at the database. Set, they verify it at boot and refuse to start if it
# is not — a connection string that claims isolation and does not have it is the
# one nobody checks again.
# DATABASE_URL_TENANT=postgresql://trading_app:...@localhost:5432/trading_platform?schema=public
# How many per-tenant pools may be open at once. Total connections are this
# times connection_limit, so it is a budget rather than a tenant limit.
# DATABASE_TENANT_POOLS=32

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Newest key first: <id>:<base64 32 bytes>[,<older>...]. `pnpm keygen <id>` prints one.
# The API refuses to start without it. See docs/security.md for how to rotate.
SECRET_ENCRYPTION_KEYS=replace_me_run_pnpm_keygen_1
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2

# --- Market data ---
# internal-simulator | external
MARKET_DATA_PROVIDER=internal-simulator
MARKET_SIMULATOR_TICK_MS=250
# Fixed seed makes the simulator deterministic for tests/replays.
MARKET_SIMULATOR_SEED=20260821

# --- Database concurrency ---
# Writes to one account serialise on its ledger row, so a burst of orders on the
# same account queues. These bound how long a queued write waits before it is
# refused as contention rather than failing as an internal error.
DATABASE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
# Prisma's pool. Raise with concurrency, not with core count alone: every queued
# transaction holds a connection while it waits.
# DATABASE_URL=...?connection_limit=25

# --- Trading engine ---
TRADING_SERVER_TIMEZONE=UTC
DEFAULT_ACCOUNT_LEVERAGE=100
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Closes positions from price movement. Turning this off means stop-loss and
# take-profit never fire on that instance — it is not a performance knob.
TRIGGER_ENGINE_ENABLED=true
# Lower bound between margin-level evaluations for one account.
STOP_OUT_CHECK_INTERVAL_MS=1000

# --- Rate limits (requests per window) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_SOCKET_MESSAGES_PER_MINUTE=100

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Charting (TradingView Advanced Charts) ---
# The library is licensed and distributed privately by TradingView.
# Place the unpacked library at apps/web/public/charting_library/ (git-ignored).
# Reserved: nothing reads this yet. The licensed TradingView bundle is not in
# the repository, so the code that would load it does not exist — the name is
# fixed here so it is not invented twice. See docs/charting.md.
NEXT_PUBLIC_CHARTING_LIBRARY_PATH=/charting_library/

# --- Auth lifecycle ---
APP_PUBLIC_URL=http://localhost:3000
# 'log' prints verification and reset links to the server log. Development only —
# the API refuses to start with this under NODE_ENV=production.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@trading-platform.local
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# open | invite | closed. Open locally; production refuses to boot open unless
# REGISTRATION_ALLOW_OPEN_IN_PRODUCTION=true says so explicitly.
REGISTRATION_MODE=open
INVITE_CODE_TTL_HOURS=168

# The tenant a request falls back to when no tenant claims its hostname.
TENANT_DEFAULT_SLUG=default
# Turn on once a second tenant exists; see docs/multi-tenancy.md.
TENANT_HOST_STRICT=false

# --- Accounts ---
DEFAULT_ACCOUNT_CURRENCY=USD
# Virtual funds credited to a new demo account, posted as a real DEPOSIT ledger
# entry. Set to 0 to open demo accounts unfunded.
DEMO_ACCOUNT_INITIAL_BALANCE=100000

# --- Tests ---
# Integration tests run against their OWN database and truncate every table in
# it between cases. They skip themselves when this is unset, so a fresh checkout
# runs the unit suite with no extra setup.
#
# To enable them: run `pnpm db:test:prepare`, then uncomment the line below.
# TEST_DATABASE_URL=postgresql://trading:change_me_locally@localhost:5432/trading_platform_test?schema=public
# The unprivileged role against the test database. `pnpm db:test:prepare` creates
# it and prints this line. Without it, rls-enforcement.test.ts skips — and a
# skipped proof of isolation reads exactly like a passing one.
# TEST_DATABASE_URL_TENANT=postgresql://trading_app:...@localhost:5432/trading_platform_test?schema=public

# --- Market feed ---
# Older than this and the engine refuses to trade on the quote.
QUOTE_MAX_AGE_MS=5000

# Market data integrity. Generous by design: this is a broken-feed detector, not
# a liquidity opinion. Zero disables a check. See docs/market-data.md.
MARKET_MAX_SPREAD_RATIO=0.05
MARKET_MAX_JUMP_RATIO=0.1
MARKET_MAX_FUTURE_SKEW_MS=5000
# Consecutive plausibility rejections after which the gate follows the market
# rather than freezing the price against an anchor that stopped moving.
MARKET_REANCHOR_AFTER=5
# Out of the vocabulary in packages/market-core; the clients ask /market/resolutions.
CANDLE_RESOLUTIONS=1,5,15,30,60,240,1D
# Exactly one process may ingest market data — two would double-count candle
# volume. Set to false on additional API replicas.
MARKET_INGEST_ENABLED=true

# --- Worker jobs ---
# Weekday carrying the weekend's financing, 0 = Sunday. Wednesday is the
# near-universal convention: a position held then is financed for three days
# because settlement rolls over the weekend. -1 charges one night every day.
SWAP_TRIPLE_DAY=3
# Cron expressions are evaluated in TRADING_SERVER_TIMEZONE, not the host's.
SWAP_ACCRUAL_CRON=0 0 * * *
RECONCILIATION_CRON=15 * * * *
MAINTENANCE_CRON=30 * * * *
# The outbox relay and webhook delivery. Both every minute; the backoff between
# attempts lives on the row rather than here. These were missing from this file
# while having defaults in the schema — which works, and leaves somebody copying
# this file with no idea the schedules exist.
OUTBOX_RELAY_CRON=* * * * *
WEBHOOK_DELIVERY_CRON=* * * * *
# Runs every scheduled job once at startup. Development only.
RUN_JOBS_ON_BOOT=false
# What this worker process does (§77): all | scheduler | processor. A processor
# may be narrowed to some queues, comma-separated (unknown names refuse to boot).
WORKER_ROLE=all
# WORKER_QUEUES=webhook-delivery,notifications
# Where each worker asks, every five minutes, whether it can reach the internet;
# the answer is in /health/jobs and verify:production fails on a no. Any HTTP
# answer counts. `off` stops the asking. Set it to your Alpine mirror if that
# is what this host is allowed to reach.
EGRESS_PROBE_URL=https://dl-cdn.alpinelinux.org/alpine/

# --- Account snapshots ---
# Taken inside the API, where the account valuation lives. 0 disables them.
ACCOUNT_SNAPSHOT_INTERVAL_MS=300000
# How often the platform asks venues what became of orders whose answer was
# lost, and how long it waits before asking (the request may still be in
# flight). 0 disables the sweep: unconfirmed orders then wait for a person.
VENUE_RECOVERY_INTERVAL_MS=30000
VENUE_RECOVERY_GRACE_MS=5000

# --- Realtime ---
# Lower bound between account valuations pushed to one connected client.
# Throttling, not polling: nothing runs when the market is still.
REALTIME_VALUATION_INTERVAL_MS=500
# How often a socket is sent the quotes that moved, at most. Ticks are conflated
# per symbol in between; 0 relays every tick. See docs/websocket.md.
QUOTE_FANOUT_INTERVAL_MS=100

# --- Payments ---
# Currencies this deployment will take money in, comma-separated.
PAYMENT_CURRENCIES=USD
# The largest single deposit the platform will start. A transfer above this is
# refused at the door rather than half-processed.
PAYMENT_MAX_AMOUNT=100000
# How long an unpaid payment stays open. The maintenance sweep expires it after.
PAYMENT_INTENT_TTL_HOURS=72
# Shown verbatim to a payer choosing a bank transfer. Configuration and not a
# constant, because a hard-coded IBAN in a repository is somebody else's bank
# account by the second deployment. Left unset, the payer is told so plainly.
#
# NOTE: the only payment provider in this repository is the manual bank
# transfer, confirmed by an operator. A third-party processor is a commercial
# decision, and the adapter for one is deliberately absent rather than written
# against documentation for a contract nobody has signed. See docs/payments.md.
# PAYMENT_BANK_DETAILS=

# --- Identity verification ---
# How long a verification stays good, in days. Leave unset and it never lapses.
# The gate honours this to the minute; the maintenance sweep writes EXPIRED.
# KYC_VALID_FOR_DAYS=
# How long identity documents are kept after a record is decided. The bytes
# are purged after this; the row stays as the record of what was seen. Five
# years is the common regulatory floor for identity records.
KYC_DOCUMENT_RETENTION_DAYS=1826
#
# NOTE: the only verification path in this repository is manual review by an
# operator holding kyc.review. An automated provider (Sumsub, Onfido, Veriff…)
# is a commercial decision and its adapter is deliberately absent. See
# docs/kyc.md.

# --- Withdrawals ---
# Smallest and largest single request, and the rolling 24-hour cap (unset = none).
WITHDRAWAL_MIN_AMOUNT=10
WITHDRAWAL_MAX_AMOUNT=50000
# WITHDRAWAL_DAILY_LIMIT=
# Hours between one request and the next. 0 means none.
WITHDRAWAL_COOLDOWN_HOURS=0
# Whether a verified identity is required. On by default.
WITHDRAWAL_REQUIRE_KYC=true
# Requests below this are approved without a person; unset means all wait.
# Approval is not payment — a person still pays and confirms every one.
# WITHDRAWAL_AUTO_APPROVE_BELOW=
#
# NOTE: payouts are made by a person holding withdrawals.pay, from the firm's
# own bank, and recorded here. An automated rail is a commercial decision and
# its adapter is deliberately absent. See docs/withdrawals.md.
#
# The FINANCE role approves and pays. It deliberately cannot confirm a deposit
# or adjust a wallet, and ADMIN deliberately cannot approve a withdrawal:
# a deployment needs at least one person in each. See docs/permissions.md.

# --- Programmatic access ---
# API keys a person mints for themselves (a subset of their own capabilities,
# never the money-moving or role-changing ones) and service tokens an
# administrator mints for an integration (reads across the tenant, nothing
# else). The secret is shown once and stored hashed. See docs/api-keys.md.
# Longest life a key or token may have, and the life a person gets by default.
API_KEY_MAX_TTL_DAYS=365
API_KEY_DEFAULT_TTL_DAYS=90
# Live keys one person may hold at once.
API_KEY_MAX_PER_USER=10
# Requests per minute one credential may make, on top of the per-address limit.
API_KEY_RATE_LIMIT_PER_MINUTE=300

# Order-path ceilings, per account and per tenant, per minute. On top of the
# per-address limit; if Redis is unreachable the order is allowed and logged.
ORDER_RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=120
ORDER_RATE_LIMIT_PER_TENANT_PER_MINUTE=6000

# How often the worker asks every enabled venue connection how it is. The
# connection's own circuit breaker is what stops this hammering a venue that
# is refusing; see docs/broker-integration.md.
BROKER_HEALTH_CRON=* * * * *

# How many proxies at the right-hand end of X-Forwarded-For were appended by
# infrastructure you own. This decides the address IP rules are enforced on, so
# unset and 0 mean different things and neither is a default:
#   unset — nobody has said. The socket address may be a client or a proxy, so
#           it is reported for logs and trusted for nothing; no IP rule is
#           enforced, and the API refuses to create one.
#   0     — a claim that nothing sits in front of this API. The socket address
#           is the client and the forwarded header is ignored entirely.
#   n     — n owned proxies append to the chain; the client is the entry
#           immediately to their left.
# Production runs behind two (host nginx, then the stack's nginx), so it sets 2.
# See docs/ip-rules.md.
TRUSTED_PROXY_HOPS=0

# Webhooks (§49). Deliveries run every minute; the backoff lives on the row.
# WEBHOOK_ALLOW_HTTP lets an http:// receiver be registered and delivered to —
# only ever for a local test receiver; a signed event over plain HTTP is a
# signed event anybody on the path can read. See docs/webhooks.md.
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DISABLE_AFTER_FAILURES=5
WEBHOOK_TIMEOUT_MS=10000

# How long an IN_PROGRESS idempotency claim may stand before a retry with the
# same key may take it over. A claim that old with nothing committed belongs to
# a process that died before it committed. See docs/order-lifecycle.md.
IDEMPOTENCY_TAKEOVER_AFTER_MS=300000

# On SIGTERM the API refuses new requests (503, Retry-After) and waits this long
# for the requests already inside it to finish before closing the database and
# Redis. Requests still running at the deadline are cut off and logged.
# Keep the container's stop grace period above this. See docs/runbook.md.
SHUTDOWN_DRAIN_TIMEOUT_MS=25000

# Idle keep-alive connections are closed after this long. Node's default of 5 s
# resets any client that reuses a connection at that instant; 65 s matches the
# edge's keepalive_timeout. See docs/runbook.md.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# Requests in flight above which newcomers get a coded 503 (Retry-After: 1)
# instead of a stalled connection. Liveness is always admitted. See docs/capacity.md.
HTTP_MAX_IN_FLIGHT=512

# TCP listen backlog — established connections the kernel queues while the
# process is busy. Node's default 511 overflowed under a 2,000-order burst and
# the excess got ECONNRESET with no answer. Clamped to net.core.somaxconn.
HTTP_LISTEN_BACKLOG=4096
# Event-loop lag (mean over the last second) above which newcomers get the
# same coded 503, whatever the count. 0 disables. See docs/capacity.md.
HTTP_MAX_EVENT_LOOP_LAG_MS=1000
# The most of the event loop one realtime valuation pass may take; accounts
# left over wait for the next pass, oldest first. See docs/capacity.md.
REALTIME_VALUATION_BUDGET_MS=250

# How long before an instrument opens the screen says "opens in N minutes", and
# how long after a close it keeps explaining itself. A display convention only:
# no order is accepted before the window opens. 0 turns the notices off. (§36)
MARKET_PRE_OPEN_MINUTES=15
MARKET_POST_CLOSE_MINUTES=15
