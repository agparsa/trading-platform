# ---------------------------------------------------------------------------
# Trading Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading:change_me_locally@localhost:5432/trading_platform?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2

# --- Market data ---
# internal-simulator | external
MARKET_DATA_PROVIDER=internal-simulator
MARKET_SIMULATOR_TICK_MS=250
# Fixed seed makes the simulator deterministic for tests/replays.
MARKET_SIMULATOR_SEED=20260821

# --- Trading engine ---
TRADING_SERVER_TIMEZONE=UTC
DEFAULT_ACCOUNT_LEVERAGE=100
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Closes positions from price movement. Turning this off means stop-loss and
# take-profit never fire on that instance — it is not a performance knob.
TRIGGER_ENGINE_ENABLED=true
# Lower bound between margin-level evaluations for one account.
STOP_OUT_CHECK_INTERVAL_MS=1000

# --- Rate limits (requests per window) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=600

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Charting (TradingView Advanced Charts) ---
# The library is licensed and distributed privately by TradingView.
# Place the unpacked library at apps/web/public/charting_library/ (git-ignored).
NEXT_PUBLIC_CHARTING_LIBRARY_PATH=/charting_library/

# --- Auth lifecycle ---
APP_PUBLIC_URL=http://localhost:3000
# 'log' prints verification and reset links to the server log. Development only —
# the API refuses to start with this under NODE_ENV=production.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@trading-platform.local
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Accounts ---
DEFAULT_ACCOUNT_CURRENCY=USD
# Virtual funds credited to a new demo account, posted as a real DEPOSIT ledger
# entry. Set to 0 to open demo accounts unfunded.
DEMO_ACCOUNT_INITIAL_BALANCE=100000

# --- Tests ---
# Integration tests run against their OWN database and truncate every table in
# it between cases. They skip themselves when this is unset, so a fresh checkout
# runs the unit suite with no extra setup.
#
# To enable them: run `pnpm db:test:prepare`, then uncomment the line below.
# TEST_DATABASE_URL=postgresql://trading:change_me_locally@localhost:5432/trading_platform_test?schema=public

# --- Market feed ---
# Older than this and the engine refuses to trade on the quote.
QUOTE_MAX_AGE_MS=5000
CANDLE_RESOLUTIONS=1,5,15,60,240,1D
# Exactly one process may ingest market data — two would double-count candle
# volume. Set to false on additional API replicas.
MARKET_INGEST_ENABLED=true

# --- Worker jobs ---
# Weekday carrying the weekend's financing, 0 = Sunday. Wednesday is the
# near-universal convention: a position held then is financed for three days
# because settlement rolls over the weekend. -1 charges one night every day.
SWAP_TRIPLE_DAY=3
# Cron expressions are evaluated in TRADING_SERVER_TIMEZONE, not the host's.
SWAP_ACCRUAL_CRON=0 0 * * *
RECONCILIATION_CRON=15 * * * *
MAINTENANCE_CRON=30 * * * *
# Runs every scheduled job once at startup. Development only.
RUN_JOBS_ON_BOOT=false
