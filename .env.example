# ---------------------------------------------------------------------------
# Trading Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading:change_me_locally@localhost:5432/trading_platform?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2

# --- Market data ---
# internal-simulator | external
MARKET_DATA_PROVIDER=internal-simulator
MARKET_SIMULATOR_TICK_MS=250
# Fixed seed makes the simulator deterministic for tests/replays.
MARKET_SIMULATOR_SEED=20260821

# --- Trading engine ---
TRADING_SERVER_TIMEZONE=UTC
DEFAULT_ACCOUNT_LEVERAGE=100
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- Rate limits (requests per window) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=120
RATE_LIMIT_API_PER_MINUTE=600

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Charting (TradingView Advanced Charts) ---
# The library is licensed and distributed privately by TradingView.
# Place the unpacked library at apps/web/public/charting_library/ (git-ignored).
NEXT_PUBLIC_CHARTING_LIBRARY_PATH=/charting_library/
