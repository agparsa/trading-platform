{
  "name": "@tp/integrity-core",
  "version": "0.1.0",
  "private": true,
  "description": "Observing patterns in trading activity. Signals, never verdicts. Pure domain logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@tp/shared-types": "workspace:*",
    "@tp/financial-core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
