{
  "name": "trading-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" \"apps/web/.next\" \"**/*.tsbuildinfo\"",
    "verify": "pnpm build:packages && pnpm lint && pnpm format:check && pnpm typecheck && pnpm inventory --check && pnpm check:schema && pnpm test && pnpm build",
    "prepare": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "check:schema": "tsx --env-file-if-exists=.env scripts/assert-no-float-columns.ts",
    "inventory": "tsx scripts/api-inventory.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke-api.ts",
    "db:test:prepare": "tsx --env-file-if-exists=.env scripts/prepare-test-db.ts",
    "db:roles": "tsx --env-file-if-exists=.env scripts/provision-db-roles.ts",
    "smoke:ws": "tsx --env-file-if-exists=.env scripts/smoke-ws.ts",
    "smoke:contracts": "tsx --env-file-if-exists=.env scripts/smoke-contracts.ts",
    "smoke:web": "tsx --env-file-if-exists=.env scripts/smoke-web.ts",
    "smoke:worker": "tsx --env-file-if-exists=.env scripts/smoke-worker.ts",
    "load": "tsx --env-file-if-exists=.env scripts/load-test.ts",
    "keygen": "tsx scripts/keygen.ts",
    "pentest": "tsx --env-file-if-exists=.env scripts/pentest.ts",
    "soak": "tsx --env-file-if-exists=.env scripts/soak.ts",
    "restore:rehearse": "tsx --env-file-if-exists=.env scripts/restore-rehearsal.ts",
    "migrate:rehearse": "tsx --env-file-if-exists=.env scripts/migration-rehearsal.ts",
    "verify:production": "tsx --env-file-if-exists=.env scripts/verify-production.ts",
    "chaos": "tsx --env-file-if-exists=.env scripts/failure-injection.ts",
    "rotate:secrets": "tsx --env-file-if-exists=.env scripts/rotate-secrets.ts",
    "verify:coverage": "pnpm build:packages && pnpm test:coverage",
    "measure": "tsx scripts/measure-repository.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tp/crypto-core": "workspace:*",
    "@tp/market-core": "workspace:*",
    "@tp/shared-types": "workspace:*",
    "@tp/tenancy": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "^4.14.0",
    "eslint": "catalog:",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "socket.io-client": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "multer": "^2.5.0",
      "postcss": "^8.5.26",
      "deepmerge-ts": "^8.0.0",
      "decode-uri-component": "^0.5.1",
      "@expo/cli>zod": "^4.6.7",
      "vitest@>=2.1.0 <4.1.11": "4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": "4.1.11",
      "js-yaml@>=5.0.0 <=5.4.0": "5.4.1",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "tinypool@<=2.1.0": "2.1.2",
      "tinypool@<2.1.2": "2.1.2",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@>=1.8.4 <1.11.0": "1.11.0",
      "next@>=15.0.0 <15.5.27": "15.5.28",
      "vite": "7.3.7",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": "4.1.12",
      "next@>=10.0.0 <=15.5.27": "15.5.28",
      "next@>=13.0.0 <=15.5.27": "15.5.28",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "nodemailer@>=3.0.0 <10.1.4": "10.1.4",
      "nodemailer@>=3.0.0 <=10.0.12": "10.1.4",
      "qs@>=6.7.0 <=6.16.0": "6.16.1",
      "minimatch@<11.0.1": "11.0.1",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "node-forge@<=1.4.0": "1.4.1"
    }
  }
}
