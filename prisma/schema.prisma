/// A saved chart, as the trader arranged it.
///
/// ## Why the arrangement is an opaque blob
///
/// `content` is JSON this platform does not read. A chart layout is the
/// renderer's own description of itself — which studies at which settings, on
/// which panes, with what drawings and what the viewport was — and every
/// renderer describes that differently. Parsing it would mean this platform
/// having an opinion about a format it does not own, and being wrong about it
/// the first time the renderer version changes.
///
/// So it is stored, returned and replaced verbatim. What the platform *does*
/// keep in columns is what it needs to answer without parsing: whose layout,
/// which instrument, which resolution, and which one to open.
///
/// The columns are also what survives a change of renderer. A layout saved by
/// one and unreadable by the next still says what it was of.
model ChartLayout {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  /// The account this layout belongs to, when it belongs to one. Levels drawn
  /// on a chart are about an account's positions, so a trader running two
  /// accounts wants two arrangements.
  accountId String? @map("account_id") @db.Uuid

  name       String
  symbol     String
  resolution String
  /// The renderer's own description. Never parsed here.
  content    Json    @default("{}")
  /// The one to open. At most one per user and account — enforced by a partial
  /// unique index, because "which chart do I get" cannot depend on row order.
  isDefault  Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// One name per person per account: saving over a name replaces it, which is
  /// what "save" means to the person pressing it.
  @@unique([userId, accountId, name])
  @@index([tenantId, userId])
  @@map("chart_layouts")
}

/// A named set of studies, independent of any instrument.
///
/// The thing a trader builds once — a moving average, an oscillator, the
/// settings they like — and applies to whatever they open next. Kept apart
/// from `ChartLayout` because it is reusable across instruments by definition,
/// and folding it into a layout would mean copying it into every chart.
model ChartTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  name    String
  /// The renderer's own description of the studies. Never parsed here.
  content Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@index([tenantId, userId])
  @@map("chart_templates")
}

/// What a trader has drawn on one instrument.
///
/// Per person and per instrument rather than per layout: a trendline drawn on
/// gold is about gold, and a trader who opens a second layout expects their
/// lines to still be there. That is how every terminal they have used behaves,
/// and storing drawings inside a layout would silently lose them on a layout
/// switch.
model UserDrawing {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  symbol  String
  /// The renderer's own description of the drawings. Never parsed here.
  content Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, symbol])
  @@index([tenantId, userId])
  @@map("user_drawings")
}

// ---------------------------------------------------------------------------
// Trading Platform — PostgreSQL schema
//
// Conventions used throughout:
//
//  * Public identifiers are UUIDs. Sequential keys are never exposed by the API.
//  * Every monetary and price column is NUMERIC. There is no DOUBLE PRECISION
//    anywhere in this file, by design — see docs/pnl.md.
//      - money      NUMERIC(28,10)  account-currency amounts
//      - price      NUMERIC(28,10)  instrument prices
//      - volume     NUMERIC(18,8)   lots
//  * Mutable rows that the trading engine races on carry a `version` column for
//    optimistic concurrency.
//  * `*_events` and `balance_ledger` are append-only. Nothing updates or deletes
//    them; corrections are compensating entries.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A firm operating on this platform.
///
/// Every owned row carries `tenantId` directly rather than deriving it through
/// a join. Row-level security is a predicate on the row, so a policy that has to
/// join to find its tenant runs on every read and is easy to write subtly wrong;
/// and application queries do not always start at the root — `orderEvent
/// .findMany({ where: { orderId } })` is legitimate and must be scopeable
/// without the caller remembering to join. See docs/multi-tenancy.md.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  /// Stable machine name, e.g. 'devopss'. Used in configuration and in logs.
  slug String @unique
  name String

  /// The hostname this tenant answers on, when it has one of its own.
  ///
  /// Read only for requests that carry no authentication yet — sign-in,
  /// registration, password reset. Every authenticated request takes its tenant
  /// from the token instead, because a client that can name its own tenant is a
  /// client that can name somebody else's.
  primaryHost String? @unique @map("primary_host")

  status TenantStatus @default(ACTIVE)

  /// A broker is a tenant. The one PLATFORM tenant operates the deployment and,
  /// in a single-operator deployment, also trades; it is the only tenant that
  /// seeds the platform roles. Every other tenant is a BROKER.
  kind                 TenantKind    @default(BROKER)
  /// The firm's registered name, for documents and the broker panel.
  legalName            String?       @map("legal_name")
  /// Where a new account under this tenant executes unless the account says otherwise.
  defaultExecutionMode ExecutionMode @default(INTERNAL) @map("default_execution_mode")

  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  users                    User[]
  totpRecoveryCodes        TotpRecoveryCode[]
  refreshTokens            RefreshToken[]
  accounts                 Account[]
  accountSettings          AccountSettings[]
  orders                   Order[]
  orderEvents              OrderEvent[]
  positions                Position[]
  positionEvents           PositionEvent[]
  executions               Execution[]
  trades                   Trade[]
  balanceLedgers           BalanceLedger[]
  accountSnapshots         AccountSnapshot[]
  riskRuleConfigs          RiskRuleConfig[]
  riskLimitSets            RiskLimitSet[]
  riskEvents               RiskEvent[]
  auditLogs                AuditLog[]
  securityEvents           SecurityEvent[]
  brokerConnections        BrokerConnection[]
  brokerCredentials        BrokerCredential[]
  brokerInstrumentMappings BrokerInstrumentMapping[]
  outboxEvents             OutboxEvent[]
  brokerInboundEvents      BrokerInboundEvent[]
  idempotencyKeys          IdempotencyKey[]
  masterAccounts           MasterAccount[]
  masterAccountLinks       MasterAccountLink[]
  integritySignals         IntegritySignal[]
  integritySignalEvents    IntegritySignalEvent[]
  systemSettings           SystemSetting[]
  inviteCodes              InviteCode[]
  inviteRedemptions        InviteRedemption[]
  reconciliationRuns       ReconciliationRun[]
  reconciliationFindings   ReconciliationFinding[]
  notifications            Notification[]
  tenantSymbolTerms        TenantSymbolTerms[]
  devices                  Device[]
  chartLayouts             ChartLayout[]
  chartTemplates           ChartTemplate[]
  userDrawings             UserDrawing[]
  notificationPreferences  NotificationPreference[]
  notificationSettings     NotificationSetting[]
  pushDeliveries           PushDelivery[]
  roles                    Role[]
  rolePermissions          RolePermission[]
  wallets                  Wallet[]
  walletTransactions       WalletTransaction[]
  paymentIntents           PaymentIntent[]
  paymentEvents            PaymentEvent[]
  kycRecords               KycRecord[]
  kycDocuments             KycDocument[]
  withdrawalRequests       WithdrawalRequest[]
  apiKeys                  ApiKey[]
  serviceTokens            ServiceToken[]
  credentialUsage          CredentialUsage[]
  priceAlerts              PriceAlert[]
  reconciliationItems      ReconciliationItem[]
  resolutionRecords        ResolutionRecord[]
  breakGlassGrants         BreakGlassGrant[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenantKind {
  PLATFORM
  BROKER
}

/// Where an account's orders execute. EXTERNAL_BROKER is a mode before it is a
/// code path, so nothing pretends a venue is connected when none is.
enum ExecutionMode {
  INTERNAL
  EXTERNAL_BROKER
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  SUPPORT
  OPERATOR
  RISK_MANAGER
  /// Money out, and only money out. Cannot confirm a deposit or adjust a wallet.
  FINANCE
  ADMIN
  /// The administrator's powers plus the firm's own settings and branding.
  BROKER_OWNER
  BROKER_ANALYST
  BROKER_DEVELOPER
  /// Platform roles: seeded on the PLATFORM tenant only.
  PLATFORM_SUPER_ADMIN
  PLATFORM_OPERATOR
  PLATFORM_SUPPORT
  PLATFORM_AUDITOR
  PLATFORM_DEVELOPER
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String
  /// Argon2id hash. The plaintext password never reaches the database or a log.
  passwordHash  String    @map("password_hash")
  displayName   String    @map("display_name")
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false) @map("email_verified")
  /// The TOTP shared secret, sealed with AES-256-GCM and bound to this row —
  /// see common/crypto/secret-box.ts. It is the one reversible secret in this
  /// database, because verifying a six-digit code needs the secret itself.
  totpSecret    String?   @map("totp_secret")
  /// Set only once a user has proved they can produce a code. A secret with no
  /// timestamp is an enrolment somebody started and never finished; it must not
  /// stop them signing in.
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// The last 30-second step accepted for this user. A code is valid for half a
  /// minute, which is half a minute in which anyone who saw it can present it
  /// again; refusing anything at or below this makes each code work once.
  totpLastStep  BigInt?   @map("totp_last_step")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)

  /// Single-use tokens are stored hashed, never in plaintext: a database leak
  /// must not hand an attacker a working password-reset link.
  emailVerificationTokenHash String?   @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.Timestamptz(6)
  passwordResetTokenHash     String?   @unique @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz(6)

  /// Throttles credential stuffing per account, independently of the IP-based
  /// rate limiter, which an attacker with a botnet can sidestep.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts                Account[]
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  securityEvents          SecurityEvent[]
  recoveryCodes           TotpRecoveryCode[]
  masterAccounts          MasterAccount[]
  notifications           Notification[]
  invitesCreated          InviteCode[]             @relation("InviteCreator")
  invitesUsed             InviteRedemption[]
  devices                 Device[]
  chartLayouts            ChartLayout[]
  chartTemplates          ChartTemplate[]
  userDrawings            UserDrawing[]
  notificationPreferences NotificationPreference[]
  notificationSettings    NotificationSetting[]

  paymentIntents           PaymentIntent[]
  wallets                  Wallet[]
  kycRecord                KycRecord?
  withdrawals              WithdrawalRequest[]
  apiKeys                  ApiKey[]
  /// Tokens this person minted, for the audit trail; the tokens belong to the firm.
  serviceTokensMinted      ServiceToken[]
  brokerConnectionsCreated BrokerConnection[]  @relation("BrokerConnectionCreator")
  brokerCredentialsCreated BrokerCredential[]  @relation("BrokerCredentialCreator")
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  priceAlerts              PriceAlert[]
  resolutions              ResolutionRecord[]
  breakGlassAsActor        BreakGlassGrant[]   @relation("BreakGlassActor")
  breakGlassAsSubject      BreakGlassGrant[]   @relation("BreakGlassSubject")

  /// One address per tenant, not per platform: the same person may hold an account with two firms.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// A single-use way back in for the user who has lost their phone.
///
/// Stored as SHA-256 rather than Argon2 for the same reason refresh tokens are:
/// the code is 60 bits of randomness, so there is no low-entropy guess to slow
/// down. Used codes are kept, not deleted — "when was my recovery code used"
/// is a question worth being able to answer.
model TotpRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
  @@index([tenantId])
  @@map("totp_recovery_codes")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the token. A database leak must not yield usable sessions.
  tokenHash  String    @unique @map("token_hash")
  /// All tokens descended from one login share a family id. Presenting an
  /// already-rotated token means it was stolen, and the entire family is
  /// revoked — the thief and the victim are both logged out, deliberately.
  familyId   String    @map("family_id") @db.Uuid
  /// Rotation chain: the token that replaced this one.
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

enum AccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  CLOSE_ONLY
  LOCKED
  SUSPENDED
  CLOSED
}

enum AccountType {
  LIVE
  DEMO
}

model Account {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  userId   String        @map("user_id") @db.Uuid
  /// Human-facing account number, e.g. 'TP-100284'. Not the primary key.
  number   String
  type     AccountType   @default(DEMO)
  status   AccountStatus @default(ACTIVE)

  /// Where this account's orders execute. INTERNAL is the engine in this
  /// repository against its own ledger; EXTERNAL_BROKER hands each order to a
  /// venue through a connection and records what the venue did. An account is
  /// created in its tenant's default and changed only deliberately.
  executionMode      ExecutionMode @default(INTERNAL) @map("execution_mode")
  /// The connection its orders go through. Required in EXTERNAL_BROKER mode
  /// and refused otherwise, so an account cannot be half-migrated.
  brokerConnectionId String?       @map("broker_connection_id") @db.Uuid
  /// The venue's own identifier for this account. Unique per connection: two
  /// platform accounts pointed at one venue account would each book the
  /// other's fills.
  externalAccountId  String?       @map("external_account_id")
  currency           String        @db.VarChar(3)

  /// Authoritative cash balance. Derived from balance_ledger and reconciled
  /// against it by a scheduled job; the ledger is the source of truth.
  balance  Decimal @default(0) @db.Decimal(28, 10)
  leverage Int     @default(100)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  brokerConnection       BrokerConnection?       @relation(fields: [brokerConnectionId], references: [id], onDelete: Restrict)
  settings               AccountSettings?
  orders                 Order[]
  positions              Position[]
  chartLayouts           ChartLayout[]
  trades                 Trade[]
  ledger                 BalanceLedger[]
  snapshots              AccountSnapshot[]
  riskEvents             RiskEvent[]
  masterLinks            MasterAccountLink[]
  integritySignals       IntegritySignal[]
  reconciliationFindings ReconciliationFinding[]

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reconciliationItems ReconciliationItem[]

  /// Account numbers are a tenant's own sequence, and two tenants may reach TP-100001.
  @@unique([tenantId, number])
  @@unique([brokerConnectionId, externalAccountId])
  @@index([userId, status])
  @@index([tenantId])
  @@map("accounts")
}

model AccountSettings {
  accountId String @id @map("account_id") @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid

  marginCallLevelPercent Decimal @default(100) @map("margin_call_level_percent") @db.Decimal(10, 4)
  stopOutLevelPercent    Decimal @default(50) @map("stop_out_level_percent") @db.Decimal(10, 4)

  /// Null means "not enforced". No limit here is ever defaulted in code.
  maxPositionVolume  Decimal? @map("max_position_volume") @db.Decimal(18, 8)
  maxOpenPositions   Int?     @map("max_open_positions")
  maxGrossNotional   Decimal? @map("max_gross_notional") @db.Decimal(28, 10)
  maxSymbolNetVolume Decimal? @map("max_symbol_net_volume") @db.Decimal(18, 8)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("account_settings")
}

// ---------------------------------------------------------------------------
// Instruments & market data
// ---------------------------------------------------------------------------

model Symbol {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  description   String
  quoteCurrency String  @map("quote_currency") @db.VarChar(3)
  enabled       Boolean @default(true)
  /// Display grouping for the watchlist: 'Metals', 'Crypto', 'FX'.
  category      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  spec      SymbolSpec?
  sessions  MarketSession[]
  orders    Order[]
  positions Position[]
  trades    Trade[]

  tenantTerms    TenantSymbolTerms[]
  brokerMappings BrokerInstrumentMapping[]

  @@map("symbols")
}

/// One tenant's commercial terms for one instrument.
///
/// The contract specification on `SymbolSpec` is a fact about the instrument —
/// gold has a contract size of 100 whoever is trading it, and changing that
/// under open positions re-values every trade ever made in it. The *terms* are
/// a commercial decision, and two firms on one platform will legitimately set
/// different ones.
///
/// Every column is nullable, and null means "use the platform default". A
/// tenant that only wants a different margin rate does not have to restate the
/// commission, the swap and the size cap, and will not silently freeze them at
/// whatever they were the day the row was written.
model TenantSymbolTerms {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  symbolId String @map("symbol_id") @db.Uuid

  /// Whether this tenant offers the instrument at all.
  ///
  /// Distinct from `Symbol.enabled`, which is the platform saying the
  /// instrument is not tradeable by anybody — a data feed gone wrong, a
  /// contract rolled. A tenant can decline an instrument the platform offers;
  /// it cannot offer one the platform has withdrawn.
  enabled Boolean @default(true)

  marginRate       Decimal? @map("margin_rate") @db.Decimal(18, 8)
  commissionPerLot Decimal? @map("commission_per_lot") @db.Decimal(28, 10)
  swapLongPerLot   Decimal? @map("swap_long_per_lot") @db.Decimal(28, 10)
  swapShortPerLot  Decimal? @map("swap_short_per_lot") @db.Decimal(28, 10)
  maxVolume        Decimal? @map("max_volume") @db.Decimal(18, 8)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([tenantId, symbolId])
  @@index([tenantId])
  @@map("tenant_symbol_terms")
}

model SymbolSpec {
  symbolId String @id @map("symbol_id") @db.Uuid

  contractSize     Decimal @map("contract_size") @db.Decimal(28, 10)
  tickSize         Decimal @map("tick_size") @db.Decimal(28, 10)
  pricePrecision   Int     @map("price_precision")
  volumeStep       Decimal @map("volume_step") @db.Decimal(18, 8)
  volumePrecision  Int     @map("volume_precision")
  minVolume        Decimal @map("min_volume") @db.Decimal(18, 8)
  maxVolume        Decimal @map("max_volume") @db.Decimal(18, 8)
  /// Initial margin as a fraction of notional. 0.01 = 1% = 100:1.
  marginRate       Decimal @map("margin_rate") @db.Decimal(18, 8)
  commissionPerLot Decimal @default(0) @map("commission_per_lot") @db.Decimal(28, 10)
  swapLongPerLot   Decimal @default(0) @map("swap_long_per_lot") @db.Decimal(28, 10)
  swapShortPerLot  Decimal @default(0) @map("swap_short_per_lot") @db.Decimal(28, 10)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@map("symbol_specs")
}

model MarketSession {
  id          String @id @default(uuid()) @db.Uuid
  symbolId    String @map("symbol_id") @db.Uuid
  /// IANA zone the window is expressed in. Stored explicitly so a server
  /// timezone change can never silently move every session.
  timezone    String @default("UTC")
  /// 0 = Sunday .. 6 = Saturday.
  dayOfWeek   Int    @map("day_of_week")
  openMinute  Int    @map("open_minute")
  closeMinute Int    @map("close_minute")

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@unique([symbolId, dayOfWeek, openMinute])
  @@map("market_sessions")
}

model Candle {
  symbolCode String   @map("symbol_code")
  resolution String
  /// Bucket start, UTC, aligned to the resolution grid.
  time       DateTime @db.Timestamptz(6)
  open       Decimal  @db.Decimal(28, 10)
  high       Decimal  @db.Decimal(28, 10)
  low        Decimal  @db.Decimal(28, 10)
  close      Decimal  @db.Decimal(28, 10)
  volume     Decimal  @db.Decimal(28, 10)

  @@id([symbolCode, resolution, time])
  @@index([symbolCode, resolution, time(sort: Desc)])
  @@map("candles")
}

// ---------------------------------------------------------------------------
// Trading
// ---------------------------------------------------------------------------

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  NEW
  PENDING
  ACCEPTED
  /// Sent to a venue whose answer was lost. Resolved by asking the venue
  /// again, never by resending. See docs/broker-integration.md.
  UNCONFIRMED
  TRIGGERED
  PARTIALLY_FILLED
  FILLED
  MODIFY_REQUESTED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
  EXPIRED
}

enum TimeInForce {
  GTC
  IOC
  FOK
  DAY
  GTD
}

enum OrderEventType {
  CREATED
  VALIDATED
  ACCEPTED
  REJECTED
  TRIGGERED
  PARTIALLY_FILLED
  FILLED
  MODIFY_REQUESTED
  MODIFIED
  CANCEL_REQUESTED
  CANCELLED
  EXPIRED
}

enum PositionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum CloseReason {
  MANUAL
  STOP_LOSS
  TAKE_PROFIT
  TRAILING_STOP
  LIQUIDATION
  REVERSE
  SYSTEM
}

model Order {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  symbolId  String @map("symbol_id") @db.Uuid

  side        OrderSide
  type        OrderType
  status      OrderStatus @default(NEW)
  timeInForce TimeInForce @default(GTC) @map("time_in_force")

  volume       Decimal @db.Decimal(18, 8)
  filledVolume Decimal @default(0) @map("filled_volume") @db.Decimal(18, 8)

  price      Decimal? @db.Decimal(28, 10)
  stopPrice  Decimal? @map("stop_price") @db.Decimal(28, 10)
  stopLoss   Decimal? @map("stop_loss") @db.Decimal(28, 10)
  takeProfit Decimal? @map("take_profit") @db.Decimal(28, 10)

  /// Set once an opening order fills, or on creation for a closing order.
  positionId String? @map("position_id") @db.Uuid

  /// Populated only when the order was rejected; a code from TradingErrorCode.
  rejectionCode String? @map("rejection_code")

  /// The desk this order was placed through, when an operator placed it.
  ///
  /// Recorded because a resting order fills later, from the tick loop, with no
  /// caller and no route — and the desk ceiling that governed its placement
  /// must still govern its fill. Without this, an operator under a two-position
  /// desk cap could place five pending orders and have all five fill.
  ///
  /// It is also the honest answer to "who placed this", which a link id alone
  /// does not give once the link has been revoked.
  placedByMasterAccountId String? @map("placed_by_master_account_id") @db.Uuid

  /// The id **we** minted for this order before it left, and the venue's own.
  /// `clientOrderId` is the idempotency key at the venue and the key the
  /// recovery query asks by; it exists only for externally executed orders.
  clientOrderId   String? @unique @map("client_order_id")
  externalOrderId String? @map("external_order_id")

  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  account    Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  symbol     Symbol       @relation(fields: [symbolId], references: [id], onDelete: Restrict)
  position   Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  events     OrderEvent[]
  executions Execution[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, status])
  @@index([accountId, createdAt(sort: Desc)])
  /// Partial index for the trigger engine's hot query: resting orders only.
  @@index([symbolId, status])
  @@index([tenantId])
  @@map("orders")
}

/// Append-only. One row per state change, with the full before/after snapshot.
model OrderEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  orderId    String         @map("order_id") @db.Uuid
  type       OrderEventType
  fromStatus OrderStatus?   @map("from_status")
  toStatus   OrderStatus    @map("to_status")
  /// Structured, non-sensitive context: prices, volumes, reject codes.
  payload    Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([tenantId])
  @@map("order_events")
}

model Position {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  symbolId  String @map("symbol_id") @db.Uuid

  side   OrderSide
  status PositionStatus @default(OPEN)

  /// The venue's own id, when this position lives at a venue rather than only
  /// here. Unique: two platform positions pointing at one venue position
  /// would each close the other's.
  externalPositionId String? @unique @map("external_position_id")

  volume        Decimal @db.Decimal(18, 8)
  initialVolume Decimal @map("initial_volume") @db.Decimal(18, 8)

  entryPrice   Decimal  @map("entry_price") @db.Decimal(28, 10)
  /// Last executable exit price the engine marked this position at.
  currentPrice Decimal? @map("current_price") @db.Decimal(28, 10)

  stopLoss             Decimal? @map("stop_loss") @db.Decimal(28, 10)
  takeProfit           Decimal? @map("take_profit") @db.Decimal(28, 10)
  trailingStopDistance Decimal? @map("trailing_stop_distance") @db.Decimal(28, 10)
  highWaterPrice       Decimal? @map("high_water_price") @db.Decimal(28, 10)

  /// Initial margin held, in the account's currency.
  margin      Decimal @db.Decimal(28, 10)
  commission  Decimal @default(0) @db.Decimal(28, 10)
  swap        Decimal @default(0) @db.Decimal(28, 10)
  realizedPnl Decimal @default(0) @map("realized_pnl") @db.Decimal(28, 10)

  closeReason CloseReason? @map("close_reason")

  version   Int       @default(0)
  openedAt  DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  symbol  Symbol          @relation(fields: [symbolId], references: [id], onDelete: Restrict)
  orders  Order[]
  events  PositionEvent[]
  trades  Trade[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, status])
  @@index([symbolId, status])
  @@index([tenantId])
  @@map("positions")
}

/// Append-only history of everything that happened to a position.
model PositionEvent {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  positionId String          @map("position_id") @db.Uuid
  type       String
  fromStatus PositionStatus? @map("from_status")
  toStatus   PositionStatus  @map("to_status")
  payload    Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([positionId, createdAt])
  @@index([tenantId])
  @@map("position_events")
}

/// One fill. Immutable. Retains the quote it executed against for disputes.
model Execution {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  side   OrderSide
  volume Decimal   @db.Decimal(18, 8)
  price  Decimal   @db.Decimal(28, 10)

  /// The venue's own id for this fill, when the venue executed it. Unique so
  /// a redelivered event cannot book the same fill twice.
  externalExecutionId String? @unique @map("external_execution_id")

  quoteBid Decimal  @map("quote_bid") @db.Decimal(28, 10)
  quoteAsk Decimal  @map("quote_ask") @db.Decimal(28, 10)
  /// Timestamp of the quote used, distinct from when we wrote the row.
  quoteAt  DateTime @map("quote_at") @db.Timestamptz(6)

  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, executedAt(sort: Desc)])
  @@index([orderId])
  @@index([tenantId])
  @@map("executions")
}

/// A completed round trip. Written once when a position (or part of one) closes.
model Trade {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  positionId String @map("position_id") @db.Uuid
  symbolId   String @map("symbol_id") @db.Uuid

  side   OrderSide
  volume Decimal   @db.Decimal(18, 8)

  entryPrice Decimal  @map("entry_price") @db.Decimal(28, 10)
  exitPrice  Decimal  @map("exit_price") @db.Decimal(28, 10)
  entryTime  DateTime @map("entry_time") @db.Timestamptz(6)
  exitTime   DateTime @map("exit_time") @db.Timestamptz(6)

  grossPnl Decimal @map("gross_pnl") @db.Decimal(28, 10)

  /// Commission charged when the position was opened, apportioned to the volume
  /// closed here. A partial close carries its share; the shares of every close
  /// on one position sum to what was actually charged at entry.
  entryCommission Decimal @map("entry_commission") @db.Decimal(28, 10)
  /// Commission charged on this closing leg.
  exitCommission  Decimal @map("exit_commission") @db.Decimal(28, 10)
  /// entryCommission + exitCommission. The round trip's total cost of dealing.
  commission      Decimal @db.Decimal(28, 10)

  swap   Decimal @db.Decimal(28, 10)
  /// grossPnl - commission + swap. The figure that reconciles with the balance
  /// change this round trip caused.
  netPnl Decimal @map("net_pnl") @db.Decimal(28, 10)

  closeReason CloseReason @map("close_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  symbol   Symbol   @relation(fields: [symbolId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, exitTime(sort: Desc)])
  @@index([positionId])
  @@index([tenantId])
  @@map("trades")
}

// ---------------------------------------------------------------------------
// Money movement — immutable ledger
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  TRADE_PROFIT
  TRADE_LOSS
  COMMISSION
  SWAP
  FEE
  ADJUSTMENT
}

/// Append-only. Nothing in the application updates or deletes a ledger row;
/// a mistake is corrected with a compensating ADJUSTMENT entry that references
/// the original. `balanceAfter` is stored so any historical balance is
/// readable without replaying the whole account.
model BalanceLedger {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  accountId    String          @map("account_id") @db.Uuid
  type         LedgerEntryType
  /// Signed: positive credits the account, negative debits it.
  amount       Decimal         @db.Decimal(28, 10)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(28, 10)
  currency     String          @db.VarChar(3)

  /// What caused the entry: a trade, a position, an admin action.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid
  /// Set on an ADJUSTMENT that reverses an earlier entry.
  compensatesId String? @map("compensates_id") @db.Uuid

  /// Deduplication key. A retried webhook or job cannot double-credit.
  idempotencyKey String? @unique @map("idempotency_key")

  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([tenantId])
  @@map("balance_ledger")
}

/// Periodic point-in-time account state. Used for charts, reconciliation and
/// the daily reset that a future evaluation product would build on.
model AccountSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  takenAt   DateTime @map("taken_at") @db.Timestamptz(6)

  balance       Decimal  @db.Decimal(28, 10)
  equity        Decimal  @db.Decimal(28, 10)
  usedMargin    Decimal  @map("used_margin") @db.Decimal(28, 10)
  freeMargin    Decimal  @map("free_margin") @db.Decimal(28, 10)
  /// Null when no margin is committed — the ratio is undefined, not infinite.
  marginLevel   Decimal? @map("margin_level") @db.Decimal(18, 6)
  floatingPnl   Decimal  @map("floating_pnl") @db.Decimal(28, 10)
  openPositions Int      @map("open_positions")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([accountId, takenAt])
  @@index([accountId, takenAt(sort: Desc)])
  @@index([tenantId])
  @@map("account_snapshots")
}

// ---------------------------------------------------------------------------
// Risk & audit
// ---------------------------------------------------------------------------

/// Named, versioned risk rule configuration. Rules are data, never constants.
/// Which layer of the hierarchy a limit set belongs to.
enum RiskLimitLevel {
  PLATFORM
  BROKER
  DESK
}

/// One layer's risk ceilings.
///
/// The hierarchy is platform → broker → desk → account, and it only ever
/// tightens: a lower layer may set a limit stricter than the one above it and
/// may never set one looser. That is checked when a limit is written, and the
/// resolver takes the tightest value across every layer anyway — because a row
/// that reached this table some other way must not be able to widen what an
/// account may do.
///
/// Every field is optional and null means "this layer sets no opinion", not
/// "unlimited": a layer that says nothing simply passes the layer above
/// through. No limit is ever defaulted in code.
///
/// The account layer is not here. It is `AccountSettings`, where it has always
/// been, because it is one row per account and belongs beside the account's
/// other settings — this table holds the layers *above* an account.
model RiskLimitSet {
  id              String         @id @default(uuid()) @db.Uuid
  level           RiskLimitLevel
  /// Always set, including for PLATFORM — the platform is a tenant of kind
  /// PLATFORM, so one shape covers every layer and RLS covers every row.
  /// A broker reading the platform's ceiling does so deliberately and out of
  /// scope, which is the only cross-tenant read this table permits.
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Set only at DESK level.
  masterAccountId String?        @map("master_account_id") @db.Uuid

  maxPositionVolume  Decimal? @map("max_position_volume") @db.Decimal(18, 8)
  maxOpenPositions   Int?     @map("max_open_positions")
  maxGrossNotional   Decimal? @map("max_gross_notional") @db.Decimal(28, 10)
  maxSymbolNetVolume Decimal? @map("max_symbol_net_volume") @db.Decimal(18, 8)

  /// Who last set it, and when. A ceiling nobody can attribute is a ceiling
  /// nobody can question.
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  masterAccount MasterAccount? @relation(fields: [masterAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, level])
  @@map("risk_limit_sets")
}

model RiskRuleConfig {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  enabled    Boolean  @default(true)
  /// Rule-specific parameters, validated against the rule's schema on write.
  parameters Json     @default("{}")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Each tenant configures its own rules under the same names.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("risk_rules")
}

/// Every risk decision worth remembering: a rejection, a margin call, a stop-out.
model RiskEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  rule      String
  code      String
  severity  String   @default("WARNING")
  message   String
  /// Account state at the instant of the decision, so it can be re-examined.
  snapshot  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([rule, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("risk_events")
}

/// Append-only audit trail. Secrets, tokens and passwords are never written here.
model AuditLog {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  actorId      String? @map("actor_id") @db.Uuid
  /// 'USER' | 'ADMIN' | 'SYSTEM' — who acted, when actorId is absent.
  actorType    String  @map("actor_type")
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  /// State before and after, redacted of anything sensitive.
  before       Json?
  after        Json?

  requestId String?  @map("request_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([action, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Delivery guarantees
// ---------------------------------------------------------------------------

/// Idempotency records for mutating endpoints.
///
/// The unique constraint on (scope, key) is what actually prevents a retried
/// order from becoming two trades: the second request loses the insert race and
/// is served the stored response instead of executing again.
model IdempotencyKey {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Namespaced per account so two users cannot collide on the same key.
  scope    String
  key      String

  /// Hash of the request body. A key reused with a *different* payload is a
  /// client bug and must be rejected, not silently answered from cache.
  requestHash String @map("request_hash")

  status       String @default("IN_PROGRESS")
  responseCode Int?   @map("response_code")
  responseBody Json?  @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("idempotency_keys")
}

enum MasterAccountStatus {
  ACTIVE
  SUSPENDED
}

enum MasterLinkStatus {
  ACTIVE
  REVOKED
}

/// A person acting on trading accounts that are not their own.
///
/// The master account is the *subject* of a delegation, never a shortcut around
/// one: it holds no accounts by itself and confers nothing until a link exists.
/// A master with no links can see exactly as much as a stranger.
model MasterAccount {
  id       String              @id @default(uuid()) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  name     String
  status   MasterAccountStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  links  MasterAccountLink[]
  limits RiskLimitSet[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([tenantId])
  @@map("master_accounts")
}

/// One delegation: this master may do these things to this account.
///
/// Revocation is a status change and a timestamp, never a delete. "Who could
/// have closed that position last March" is a question the table must still be
/// able to answer after the answer has stopped being true.
model MasterAccountLink {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  masterAccountId String @map("master_account_id") @db.Uuid
  accountId       String @map("account_id") @db.Uuid

  /// `resource.verb` capability names, the same vocabulary the permission
  /// catalogue uses. Stored rather than derived from a role: a delegation is a
  /// specific grant to a specific person over a specific account, and a role
  /// would make every such grant move whenever the role did.
  capabilities String[]

  /// The preset this was granted as, when it was granted as one.
  ///
  /// Display and audit only — `capabilities` is what is enforced. A preset is
  /// expanded at grant time and never re-read, so widening a preset later
  /// cannot widen a delegation someone already approved. Null means the
  /// capabilities were chosen individually, or the link predates presets.
  grantedAsRole String? @map("granted_as_role")

  status MasterLinkStatus @default(ACTIVE)

  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  master  MasterAccount @relation(fields: [masterAccountId], references: [id], onDelete: Restrict)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([masterAccountId, accountId])
  @@index([accountId, status])
  @@index([tenantId])
  @@map("master_account_links")
}

enum IntegritySignalStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum IntegritySignalEventType {
  RAISED
  RECURRED
  STATUS_CHANGED
  NOTE_ADDED
}

/// An observation about an account's trading activity. Never a verdict.
///
/// One row per (account, code): a pattern that keeps recurring is the same
/// signal seen again, not a queue of identical ones. `occurrences`,
/// `firstSeenAt` and `lastSeenAt` say how persistent it is — which is exactly
/// what a reviewer needs and what a thousand duplicate rows would hide.
model IntegritySignal {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  code     String
  severity String
  status   IntegritySignalStatus @default(OPEN)

  /// The most recent observation. Every one of them, including this, is kept in
  /// `events` — this field is the convenience, not the record.
  message String

  occurrences Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  events  IntegritySignalEvent[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([accountId, code])
  @@index([status, severity])
  @@index([lastSeenAt(sort: Desc)])
  @@index([tenantId])
  @@map("integrity_signals")
}

/// Append-only history of one signal: every observation and every review step.
///
/// Nothing here is ever updated. Evidence that can be overwritten is evidence
/// that cannot be relied on, and "what did this look like when it was raised"
/// has to stay answerable after somebody has reviewed and closed it.
model IntegritySignalEvent {
  id       String                   @id @default(uuid()) @db.Uuid
  tenantId String                   @map("tenant_id") @db.Uuid
  signalId String                   @map("signal_id") @db.Uuid
  type     IntegritySignalEventType

  fromStatus IntegritySignalStatus? @map("from_status")
  toStatus   IntegritySignalStatus? @map("to_status")

  severity String?
  message  String?
  /// What the observation was made from, so a reviewer can check it.
  evidence Json?

  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  signal IntegritySignal @relation(fields: [signalId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([signalId, createdAt])
  @@index([tenantId])
  @@map("integrity_signal_events")
}

/// Platform-wide operational settings that a person changes at runtime.
///
/// One row per setting, with the actor who last changed it. Deliberately not an
/// environment variable: a kill switch that needs a deployment to flip is a kill
/// switch that will not be flipped in the minute it is needed.
/// Platform and per-tenant settings — the kill switch, principally.
///
/// `tenantId` null means the whole platform. That is the one hybrid in the
/// schema and it earns its complexity: an operator must be able to halt one
/// tenant, and the platform operator must be able to halt everything.
///
/// The key was the primary key when there was one tenant. It is now a plain
/// column with a surrogate id, because `@@id([key, tenantId])` cannot hold a
/// nullable column. Uniqueness is enforced twice, and the second one is not
/// visible here: `@@unique([tenantId, key])` covers the tenant rows, and the
/// migration adds a partial unique index on `key WHERE tenant_id IS NULL` for
/// the platform-wide ones — which the composite cannot do, because Postgres
/// treats two NULLs as distinct and would happily store two platform-wide kill
/// switches disagreeing with each other.
model SystemSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  tenantId        String?  @map("tenant_id") @db.Uuid
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Registration control
// ---------------------------------------------------------------------------

/// An invitation to open an account, when REGISTRATION_MODE=invite.
///
/// The code itself is never stored. What is stored is its SHA-256 and a short
/// fingerprint, so a code can be identified in a list and matched at
/// redemption, and a database leak yields no usable invitations. The plaintext
/// is shown once, to the administrator who minted it, and then is gone —
/// the same contract the specification requires of API keys.
model InviteCode {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// SHA-256 of the code, hex. Unique so a redemption is a single indexed read.
  codeHash    String  @unique @map("code_hash")
  /// First eight characters of the code, to identify it in a list. Not enough
  /// to redeem: the remainder carries the entropy.
  fingerprint String
  /// What this invitation is for, in a human's words. Shown in the admin list.
  label       String?

  createdById String? @map("created_by_id") @db.Uuid

  /// How many accounts this code may open. One, unless deliberately widened.
  maxUses  Int @default(1) @map("max_uses")
  useCount Int @default(0) @map("use_count")

  /// The role the person who redeems this receives, instead of USER. How a
  /// broker's first owner is appointed: the platform mints the invitation on
  /// the new tenant, and whoever registers with it owns the firm.
  grantsRole UserRole? @map("grants_role")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy   User?              @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions InviteRedemption[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("invite_codes")
}

/// Who used which invitation, and when.
///
/// Separate from a counter on the code because "how many are left" and "who
/// came in on this" are different questions, and only the second one survives
/// somebody asking where a user came from six months later.
model InviteRedemption {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  inviteCodeId String   @map("invite_code_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  redeemedAt   DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([inviteCodeId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("invite_redemptions")
}

// ---------------------------------------------------------------------------
// Reconciliation
// ---------------------------------------------------------------------------

/// What a run compared.
///
/// `INTERNAL` is the platform's records against each other — orders, positions,
/// trades and the ledger, each written by its own code path inside the same
/// transaction, so a disagreement means exactly one of them is wrong.
/// `EXTERNAL` is the platform against a venue, where a disagreement can also
/// mean the venue is right and we are behind.
enum ReconciliationKind {
  INTERNAL
  EXTERNAL
}

/// The statuses §44 names.
enum ReconciliationItemStatus {
  MATCHED
  MISSING_INTERNAL
  MISSING_EXTERNAL
  QUANTITY_MISMATCH
  PRICE_MISMATCH
  FEE_MISMATCH
  BALANCE_MISMATCH
  /// Both sides had it and it could not be compared. Deliberately not MATCHED.
  UNKNOWN
}

enum ReconciliationSubject {
  BALANCE
  ORDER
  POSITION
  EXECUTION
}

enum ReconciliationRunStatus {
  /// Requested and not yet picked up, or picked up and still working.
  RUNNING
  COMPLETED
  /// The run itself failed. Distinct from a run that completed and found things.
  FAILED
}

enum ReconciliationFindingStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  /// Looked at, and the records were right after all.
  FALSE_POSITIVE
}

/// One pass of the reconciliation checks over every account.
///
/// Recorded even when it finds nothing, and that is the point: "the last run was
/// clean" and "there has been no run since Tuesday" look identical if only
/// findings are stored, and only one of them is reassuring.
model ReconciliationRun {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  status            ReconciliationRunStatus @default(RUNNING)
  /// 'SCHEDULED' | 'MANUAL' — how this run came to happen.
  trigger           String                  @default("SCHEDULED")
  /// Set when a person asked for it.
  requestedByUserId String?                 @map("requested_by_user_id") @db.Uuid

  accountsChecked  Int @default(0) @map("accounts_checked")
  findingsRaised   Int @default(0) @map("findings_raised")
  findingsRecurred Int @default(0) @map("findings_recurred")
  criticalCount    Int @default(0) @map("critical_count")

  kind               ReconciliationKind @default(INTERNAL)
  /// The venue this run compared against. Null for an internal run.
  brokerConnectionId String?            @map("broker_connection_id") @db.Uuid

  /// How many things were compared, and how they came out.
  ///
  /// Counted rather than stored row by row. A matched order is a row the
  /// platform would write on every run for the life of the account, and
  /// hundreds of thousands of them say exactly what this one integer says.
  /// Everything that did *not* match is a row — see `ReconciliationItem`.
  itemsCompared   Int @default(0) @map("items_compared")
  itemsMatched    Int @default(0) @map("items_matched")
  itemsMismatched Int @default(0) @map("items_mismatched")
  itemsMissing    Int @default(0) @map("items_missing")
  /// Items nobody could compare. A run with these is not a clean run.
  itemsUnknown    Int @default(0) @map("items_unknown")

  /// Why the run itself failed. Never a finding — a finding is a successful run.
  error String?

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")

  findings ReconciliationFinding[]
  items    ReconciliationItem[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([kind, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([tenantId])
  @@map("reconciliation_runs")
}

/// A discrepancy between records that should agree.
///
/// One row per (account, code, subject), like an integrity signal and for the
/// same reason: a drift that is still there on the next run is the same drift
/// seen again, not a second one. `occurrences`, `firstSeenAt` and `lastSeenAt`
/// say how persistent it is, which is what an investigator needs and what a
/// thousand duplicate rows would bury.
///
/// `subjectKey` exists because PostgreSQL does not treat two NULLs as equal in a
/// unique index — a nullable subject would let the same account-wide finding be
/// inserted without limit. The empty string means "about the account itself".
model ReconciliationFinding {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// The run that most recently saw it. The first is in `firstSeenAt`.
  runId    String @map("run_id") @db.Uuid

  accountId String @map("account_id") @db.Uuid
  code      String
  severity  String

  status ReconciliationFindingStatus @default(OPEN)

  /// Decimal strings, kept as text: these are evidence, not operands. Storing
  /// them as NUMERIC would invite arithmetic on a record of an inconsistency.
  expected   String
  actual     String
  difference String

  subjectType String? @map("subject_type")
  subjectId   String? @map("subject_id") @db.Uuid
  /// Non-null discriminator for the unique index. Empty means the account itself.
  subjectKey  String  @default("") @map("subject_key")

  message     String
  occurrences Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote   String?   @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  run     ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  account Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resolutions ResolutionRecord[]

  @@unique([accountId, code, subjectKey])
  @@index([status, severity])
  @@index([lastSeenAt(sort: Desc)])
  @@index([tenantId])
  @@map("reconciliation_findings")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// The operating system a registered device runs.
///
/// `WEB` is here because a browser is a push target too: the Web Push protocol
/// carries the same payloads to a closed tab that APNs carries to a closed app.
/// Keeping it in one enum means the fan-out asks "which devices" once rather
/// than once per platform.
enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// A group of notifications a person can turn off as a unit.
///
/// Deliberately coarser than `Notification.kind`. A trader wants one switch for
/// "tell me when a stop loss fires", not one per instrument, and a kind is free
/// to be added without every existing preference row becoming wrong: an unknown
/// kind maps to a category, and a category with no row falls back to its
/// default rather than to silence.
enum NotificationCategory {
  TRADE_OPENED
  TRADE_CLOSED
  TRADE_MODIFIED
  ORDER_FILLED
  ORDER_CANCELLED
  STOP_LOSS
  TAKE_PROFIT
  RISK_ALERT
  SECURITY_ALERT
  /// A level the trader asked to be told about. Mutable, unlike RISK_ALERT:
  /// nothing happens to the account if it is missed.
  PRICE_ALERT
  SYSTEM
}

/// Something the platform decided a person should be told.
///
/// Written by the notification worker, never by a request handler: a
/// notification that only exists because somebody's browser was open is a
/// notification the person who was away never gets.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Stable machine name, e.g. 'risk.margin_call'. The UI maps it to wording.
  kind     String
  severity String @default("INFO")
  title    String
  body     String

  /// Whatever the event carried, so the message can be rebuilt or investigated.
  data Json @default("{}")

  /// The account it concerns, when it concerns one.
  accountId String? @map("account_id") @db.Uuid

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)
  /// Deduplication key. A risk engine that raises the same alert twice in a
  /// minute must not produce two rows.
  dedupeKey String?   @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pushDeliveries PushDelivery[]

  /// Deduplication is per tenant; two tenants may raise the same alert in the same minute.
  @@unique([tenantId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("notifications")
}

/// A phone, tablet or browser this person has signed in from.
///
/// ## Why the push token is sealed
///
/// A push token is a bearer credential: anyone holding it can deliver a
/// notification to that device, and a notification that looks like it came from
/// a trading platform is a phishing vector aimed at someone who is already
/// expecting messages about their money. So it is sealed with AES-256-GCM the
/// same way the TOTP secret is, and — per §28 — never returned by any endpoint
/// a trader can call. `pushTokenFingerprint` exists so support can say "the
/// token ending 4f21 stopped working" without the token being readable.
///
/// ## Why `installationId` and not the token
///
/// FCM and APNs both rotate tokens without being asked. Keyed on the token, a
/// rotation creates a second row and the trader gets every notification twice;
/// keyed on a client-generated installation id that survives the rotation, the
/// same row is updated. This is the whole of the duplicate-device problem and
/// it is solved here rather than by deduplicating at delivery time.
model Device {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  platform DevicePlatform

  /// Stable per-installation identifier generated by the client. Survives token
  /// rotation, app updates and re-login; changes on reinstall, which is correct
  /// — a reinstall is a new installation.
  installationId String @map("installation_id")

  /// Sealed push token. Null for a device that has registered but not yet been
  /// granted notification permission, which is the normal state on first run.
  pushToken String? @map("push_token")

  /// Last 4 characters of the plaintext token, for support and for logs. Not a
  /// secret and not enough to send anything.
  pushTokenFingerprint String? @map("push_token_fingerprint")

  /// Set when the provider tells us the token is dead (FCM `UNREGISTERED`).
  /// Kept rather than cleared so a device that stops receiving has a reason.
  pushTokenRejectedAt DateTime? @map("push_token_rejected_at") @db.Timestamptz(6)

  appVersion String? @map("app_version")
  osVersion  String? @map("os_version")
  /// Human-readable hardware name, e.g. 'iPhone 15 Pro'. For the user's own
  /// device list, so they can recognise which one to revoke.
  model      String?

  /// The locale the device asked for, so a notification can be written in it.
  locale String?

  isActive   Boolean  @default(true) @map("is_active")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// One row per installation per user. Two people sharing a phone get two
  /// rows, which is right: signing out of one account must not silence the
  /// other.
  pushDeliveries PushDelivery[]

  @@unique([tenantId, userId, installationId])
  @@index([tenantId, userId, isActive])
  @@index([tenantId])
  @@map("devices")
}

/// Whether this person wants to hear about one category, and how.
///
/// A missing row means "the default for that category", not "off". That
/// distinction is what lets a category be added later without silently muting
/// it for everyone who has ever saved a preference.
model NotificationPreference {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  category NotificationCategory

  /// Shown in the notification centre and streamed to an open terminal.
  inApp Boolean @default(true) @map("in_app")
  /// Delivered to registered devices when the app is not in the foreground.
  push  Boolean @default(true)
  /// Whether the client plays this category's sound. The server carries the
  /// flag because the setting must follow the person to a new device.
  sound Boolean @default(true)
  email Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, category])
  @@index([tenantId])
  @@map("notification_preferences")
}

/// The switches that apply across every category.
///
/// Separate from `NotificationPreference` because they are a different shape:
/// one row per person rather than one per person per category, and turning
/// `pushEnabled` off must silence push for every category at once without
/// rewriting ten rows and without losing what those rows said.
model NotificationSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Master switch for everything that is not security-critical.
  tradingEnabled   Boolean @default(true) @map("trading_enabled")
  pushEnabled      Boolean @default(true) @map("push_enabled")
  soundEnabled     Boolean @default(true) @map("sound_enabled")
  vibrationEnabled Boolean @default(true) @map("vibration_enabled")

  /// 0–100. Stored as an integer because it is a UI setting, not money.
  soundVolume Int @default(80) @map("sound_volume")

  /// Local time range during which push is withheld, as minutes from midnight
  /// in `quietHoursTimezone`. Null means no quiet hours. In-app notices are
  /// unaffected: the row is still written, it just does not wake the phone.
  quietHoursStartMinute Int?    @map("quiet_hours_start_minute")
  quietHoursEndMinute   Int?    @map("quiet_hours_end_minute")
  quietHoursTimezone    String? @map("quiet_hours_timezone")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("notification_settings")
}

/// What happened when we tried to push one notification to one device.
///
/// §36 asks the Admin panel for Sent / Delivered / Failed / Pending. Three of
/// those are knowable and one is not: FCM acknowledges that it *accepted* the
/// message, never that the phone displayed it, and no push provider offers
/// that. So this records what actually happened at our boundary and the admin
/// view says "sent" rather than "delivered", because claiming delivery we
/// cannot observe is the kind of number that gets believed and then acted on.
model PushDelivery {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  notificationId String @map("notification_id") @db.Uuid
  deviceId       String @map("device_id") @db.Uuid

  status   PushDeliveryStatus @default(PENDING)
  attempts Int                @default(0)

  /// The provider's error code, verbatim, e.g. 'UNREGISTERED'. Kept as text
  /// rather than an enum: a code we have never seen must still be recorded.
  errorCode         String? @map("error_code")
  /// The provider's own id for the message, for correlating with their console.
  providerMessageId String? @map("provider_message_id")

  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// One attempt record per notification per device. A retried job updates the
  /// row rather than writing a second one, so the count of rows is the count of
  /// intended deliveries and not the count of tries.
  @@unique([notificationId, deviceId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("push_deliveries")
}

enum PushDeliveryStatus {
  /// Queued, not yet attempted.
  PENDING
  /// Accepted by the provider. Not the same as shown on the phone.
  SENT
  /// The provider refused, and the reason may pass.
  FAILED
  /// The provider says this token is dead. The device was marked accordingly.
  DROPPED
  /// The user's preferences said not to send. Recorded so the admin view can
  /// distinguish "we chose not to" from "we tried and failed".
  SKIPPED
}

/// A named set of capabilities, per tenant.
///
/// Capabilities themselves stay in code — `ALL_PERMISSIONS` in
/// `@tp/shared-types` — because code is what checks them, and a capability that
/// exists only as a row is a capability no route can require. What lives here is
/// the *grant*: which role carries which capability, which is the part a firm
/// needs to change without a deployment.
///
/// Seeded from `ROLE_PERMISSIONS` so that the first day after this migration
/// behaves exactly like the last day before it.
model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Stable machine name. For the built-in roles this equals a `UserRole`
  /// value, which is how a user's `role` column finds its grants.
  key         String
  name        String
  description String?

  /// When somebody last changed what this role carries, or null if nobody has.
  ///
  /// It exists so a release that *adds* a capability can reach the roles nobody
  /// has opinions about. A built-in role that has never been edited tracks the
  /// build: the seed sets it to the shipped set on every deploy. One that has
  /// been edited is the operator's, and is left exactly as they left it — a
  /// deploy that silently re-widened a role somebody deliberately narrowed would
  /// be the worst kind of regression, because nothing would look wrong.
  ///
  /// `resetToDefaults` clears it back to null: the role is the build's again.
  grantsEditedAt DateTime? @map("grants_edited_at") @db.Timestamptz(6)

  /// Seeded rather than created by a person.
  ///
  /// A system role's `key` cannot change and the role cannot be deleted, because
  /// users point at it by key and a dangling pointer here is an account that can
  /// do nothing or — far worse, if the key were reused — everything. Its
  /// *grants* are editable like any other's; that is the entire point of the
  /// change.
  isSystem Boolean @default(false) @map("is_system")

  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// One capability held by one role.
///
/// A row per capability rather than an array column, so that granting and
/// revoking are inserts and deletes with a unique constraint behind them — two
/// administrators pressing save at once cannot produce a duplicate, and the
/// audit record of what changed is the row itself.
model RolePermission {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  /// A `Permission` value. Validated against `ALL_PERMISSIONS` on write, because
  /// a row naming a capability this build does not know is a grant that silently
  /// does nothing.
  permission String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Money that belongs to a person rather than to a trading account.
///
/// ## Why this is not a second balance for the same money
///
/// The platform now has two ledgers, and the plan for this phase said in one
/// line why that is dangerous: two ledgers that both believe they are
/// authoritative is the classic way to lose money. They are not authoritative
/// for the same thing.
///
///   * `balance_ledger` is authoritative for what is *inside a trading account*,
///     and `accounts.balance` is its cached head.
///   * `wallet_transactions` is authoritative for what is *held for the person
///     and not in any trading account*, and `wallets.balance` is its cached head.
///
/// A transfer moves money between the two pots in one transaction, writing one
/// row on each side, and the two amounts must sum to zero. That invariant is
/// what `WalletService.transfer` exists to keep and what the integration tests
/// check by adding the pots up before and after.
///
/// One wallet per person per currency. A person trading a USD account and a EUR
/// account has two, because a wallet holding two currencies would need a rate to
/// state its balance, and a balance that changes when nobody moved any money is
/// not a balance.
model Wallet {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  currency String @db.VarChar(3)

  /// Cached head of `wallet_transactions`. The transactions are the truth.
  balance Decimal      @default(0) @db.Decimal(28, 10)
  status  WalletStatus @default(ACTIVE)

  /// Bumped on every write, so a stale read cannot silently overwrite a newer one.
  version Int @default(0)

  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@unique([userId, currency])
  @@index([tenantId])
  @@map("wallets")
}

enum WalletStatus {
  ACTIVE
  /// No movement in or out. Set during a fraud review; the money is not taken,
  /// it is held — which is a different thing and the audit trail says which.
  FROZEN
}

/// One movement on a wallet. Append-only, exactly like the balance ledger.
model WalletTransaction {
  id       String                @id @default(uuid()) @db.Uuid
  tenantId String                @map("tenant_id") @db.Uuid
  walletId String                @map("wallet_id") @db.Uuid
  type     WalletTransactionType
  /// Signed: positive credits the wallet, negative debits it.
  amount   Decimal               @db.Decimal(28, 10)

  balanceAfter Decimal @map("balance_after") @db.Decimal(28, 10)
  currency     String  @db.VarChar(3)

  /// The trading account a transfer moved money to or from.
  accountId     String? @map("account_id") @db.Uuid
  /// The `balance_ledger` row written by the same transaction.
  ///
  /// Not a foreign key on purpose: it points at the *other* ledger, and a
  /// constraint between two append-only tables would make deleting either
  /// impossible in a way that hides which one is authoritative. It is a
  /// reference for an auditor reading one side and looking for the other, and
  /// `wallet.test.ts` checks that every transfer row has one.
  ledgerEntryId String? @map("ledger_entry_id") @db.Uuid

  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid
  /// Set on an ADJUSTMENT that reverses an earlier movement.
  compensatesId String? @map("compensates_id") @db.Uuid

  /// Deduplication. A retried transfer or webhook cannot double-credit.
  idempotencyKey String? @unique @map("idempotency_key")

  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([accountId])
  @@index([tenantId])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  /// Money arrived from outside the platform.
  DEPOSIT
  /// Money left the platform.
  WITHDRAWAL
  /// From a trading account into the wallet.
  TRANSFER_IN
  /// From the wallet into a trading account.
  TRANSFER_OUT
  /// A correction, always compensating an earlier row.
  ADJUSTMENT
  FEE
}

/// One attempt to put money into the platform.
///
/// Provider-agnostic on purpose. Every provider has its own vocabulary for what
/// a payment is doing, and an adapter's job is to translate it into
/// `PaymentStatus` — the platform must not learn a new set of words each time a
/// different contract is signed. See `@tp/payments-core`.
///
/// The wallet is credited on exactly one transition, into SUCCEEDED, with an
/// idempotency key derived from this row's id. A provider that delivers its
/// success webhook three times therefore credits once, and a payment that fails
/// after being credited raises an alarm rather than silently reversing — a real
/// reversal is a chargeback, which is its own movement with its own record.
model PaymentIntent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// Which adapter owns this payment. Also how a webhook is routed.
  provider          String
  /// The provider's own identifier, once it has told us one.
  providerReference String? @map("provider_reference")

  amount   Decimal @db.Decimal(28, 10)
  currency String  @db.VarChar(3)

  status PaymentStatus @default(REQUIRES_ACTION)

  /// What the payer was told to do. Bank details, a reference to quote, a URL.
  instructions String?

  /// The wallet movement this payment produced, once it succeeded.
  walletTransactionId String? @map("wallet_transaction_id") @db.Uuid

  /// Why it ended the way it did, in words an operator can act on.
  failureReason String? @map("failure_reason")

  /// After this, an unpaid intent is expired by the maintenance job. A payment
  /// that stays open forever is a queue nobody can ever finish reading.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([tenantId])
  @@map("payment_intents")
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// One webhook delivery, kept whether or not it changed anything.
///
/// `(provider, providerEventId)` is unique, and that constraint is the whole
/// safety mechanism: a provider *will* deliver the same event twice — after a
/// timeout, after a retry, after its own outage — and the second insert fails
/// rather than the second credit succeeding.
///
/// Deliveries that changed nothing are stored too. An operator asking "did they
/// tell us?" needs the answer to be the record rather than a log line that has
/// rotated away.
model PaymentEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  intentId String @map("intent_id") @db.Uuid

  provider        String
  providerEventId String        @map("provider_event_id")
  /// What the provider called it, verbatim.
  providerStatus  String        @map("provider_status")
  /// What that maps to here.
  status          PaymentStatus

  /// apply | ignore | alarm — what the state machine did with it.
  outcome String
  /// Why, when it was not applied.
  note    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([intentId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("payment_events")
}

/// One person's identity verification. At most one per user.
///
/// Kept apart from trading on purpose: a withdrawal may require this to be
/// VERIFIED; opening a position never asks. The two must be able to change
/// independently, and a column on `users` would make every trading query carry
/// a verification status it has no business reading.
///
/// The documents are on `kyc_documents`, sealed. Nothing here is sensitive in
/// itself — a status and some dates — which is why this table can be read by a
/// support role that must never see the documents behind it.
model KycRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @unique @map("user_id") @db.Uuid

  status KycStatus @default(NOT_STARTED)

  /// Which path decided it: 'manual' for an operator, or a provider's name.
  provider          String  @default("manual")
  providerReference String? @map("provider_reference")

  /// Why it was refused or revoked, in words the person is shown.
  reason String?

  /// Who is looking at it, once someone has opened it from the queue.
  reviewerId  String?   @map("reviewer_id") @db.Uuid
  /// Who decided, and when. Null until a decision.
  decidedById String?   @map("decided_by_id") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  /// When the verification lapses, if the deployment sets a validity. The
  /// maintenance sweep writes EXPIRED at this instant; the gate checks it
  /// itself in between, so a lapse does not wait for a schedule.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  /// Bumped on every write, so a decision cannot overwrite a newer one.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents KycDocument[]

  @@index([status, submittedAt])
  @@index([tenantId])
  @@map("kyc_records")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

/// One identity document, sealed.
///
/// ## What is and is not in this row
///
/// `content` is AES-256-GCM under the platform's sealing key, bound to this
/// row's id — a document copied into another person's row fails to open there.
/// `sha256` is of the plaintext, so an operator can confirm a file is the one
/// that was uploaded without decrypting it, and so the same file submitted twice
/// is recognisable.
///
/// `content` is **null once purged**. The row stays: that a document of this
/// kind was submitted on this date, its size and its hash, are facts the record
/// may need to stand on for years — the bytes are not. The retention policy is
/// `KYC_DOCUMENT_RETENTION_DAYS` after a record reaches a terminal state, and
/// `purgedAt` says when it was applied.
///
/// Nothing from this table is ever written to an application log. The `kyc`
/// module's logger is given ids and kinds, never names, numbers or bytes.
model KycDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  recordId String @map("record_id") @db.Uuid

  kind        KycDocumentKind
  contentType String          @map("content_type")
  /// Of the plaintext. Not secret; not enough to reconstruct anything.
  sha256      String          @db.VarChar(64)
  sizeBytes   Int             @map("size_bytes")
  /// The original filename, for the reviewer. Not trusted for anything.
  filename    String?

  /// Sealed bytes. Null after the retention sweep has run.
  content Bytes? @map("content")

  /// Which sealing key wrote `content`, copied out of the frame so a rotation job
  /// can find rows to rewrite without opening each one.
  sealedWithKeyId String? @map("sealed_with_key_id")

  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  purgedAt   DateTime? @map("purged_at") @db.Timestamptz(6)

  record KycRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([recordId])
  @@index([tenantId])
  @@map("kyc_documents")
}

enum KycDocumentKind {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENCE
  PROOF_OF_ADDRESS
  SELFIE
}

/// A request to pay money out of a wallet.
///
/// ## The hold
///
/// The wallet is debited when the request is made — `holdTransactionId` is that
/// movement — and credited back, by a compensating movement, if the request
/// ends any way but PAID. Between those two the money is on the platform and in
/// nobody's balance, which is the only honest place for it: a balance that
/// still showed it could be transferred into a trading account and traded
/// while a bank transfer of the same money was in flight.
///
/// ## The destination
///
/// Where the money goes is a bank account or similar, given by the person, and
/// it is sealed with this row's id as the context — like an identity document,
/// and for the same reason. `destinationHint` is the last few characters, for
/// the person's own list; an operator paying the request opens the whole thing,
/// and that opening is audited.
model WithdrawalRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  walletId String @map("wallet_id") @db.Uuid

  amount   Decimal @db.Decimal(28, 10)
  currency String  @db.VarChar(3)

  status WithdrawalStatus @default(REQUESTED)

  /// Sealed. Opened by an operator paying the request; every opening audited.
  destination     String
  /// Last characters of the destination, for a list. Not enough to pay anything.
  destinationHint String @map("destination_hint")

  /// The wallet movement that took the money out at request time.
  holdTransactionId    String  @unique @map("hold_transaction_id") @db.Uuid
  /// The compensating movement that gave it back, if the request did not end PAID.
  releaseTransactionId String? @unique @map("release_transaction_id") @db.Uuid

  /// Which rail paid it: 'manual' for a person, or a provider's name.
  provider          String  @default("manual")
  providerReference String? @map("provider_reference")

  /// Why it was refused or failed, in words the person is shown.
  reason String?

  reviewerId   String?   @map("reviewer_id") @db.Uuid
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  /// True when the amount was under the auto-approval threshold and no person said yes.
  autoApproved Boolean   @default(false) @map("auto_approved")
  paidById     String?   @map("paid_by_id") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)

  /// Bumped on every write, so a decision cannot overwrite a newer one.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("withdrawal_requests")
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  FAILED
}

/// A person's programmatic credential. It acts as them, within a subset of
/// their capabilities fixed at minting and intersected with their current ones
/// on every use.
///
/// One line in a person's security feed, and one in the firm's.
///
/// Derived from the audit log rather than written beside it: `AuditService`
/// writes a row here whenever the action it is recording is one of the kinds
/// below, in the same transaction when it has one. So the feed cannot disagree
/// with the audit trail, and a sign-in that reached the audit log reached the
/// feed. Append-only, like its source. See docs/security-events.md.
model SecurityEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Whose security this concerns. Null when nobody's yet — a failed sign-in
  /// for an address nobody has is the firm's business, not a person's.
  userId String? @map("user_id") @db.Uuid

  kind     SecurityEventKind
  severity SecuritySeverity

  /// Who caused it: the person themselves, a member of staff, or nobody.
  actorId   String? @map("actor_id") @db.Uuid
  actorType String  @map("actor_type")

  requestId String? @map("request_id")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  /// What the audit row said, already redacted. Never a secret.
  details Json?

  /// The audit row this was derived from, for the investigator who wants the rest.
  auditLogId String? @map("audit_log_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("security_events")
}

enum SecurityEventKind {
  SIGN_IN
  SIGN_IN_FAILED
  SECOND_FACTOR_FAILED
  SIGN_IN_NEW_DEVICE
  SIGN_OUT
  SESSION_REVOKED
  SESSIONS_REVOKED_BY_STAFF
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  RECOVERY_CODE_USED
  API_KEY_MINTED
  API_KEY_REVOKED
  SERVICE_TOKEN_MINTED
  SERVICE_TOKEN_REVOKED
  ROLE_ASSIGNED
  USER_SUSPENDED
  USER_REINSTATED
  USER_UNLOCKED
  /// Somebody with a reason looked through this person's eyes (§9). WARNING,
  /// because it is the account owner's business and they are entitled to know.
  BREAK_GLASS_OPENED
  BREAK_GLASS_CLOSED
}

enum SecuritySeverity {
  INFO
  NOTICE
  WARNING
}

/// The secret is nowhere. `secretHash` is its SHA-256; `fingerprint` is the
/// public name a person identifies it by, and what every list and audit row
/// shows. See docs/api-keys.md.
model ApiKey {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// What the person called it: "trading bot", "spreadsheet".
  name               String
  /// `tpk_<handle>`. Unique, public, and what the key is looked up by.
  fingerprint        String   @unique
  secretHash         String   @map("secret_hash")
  /// `Permission` values, validated against KEYABLE_PERMISSIONS and the holder's role at minting.
  permissions        String[]
  rateLimitPerMinute Int      @map("rate_limit_per_minute")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp String?   @map("last_used_ip")

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Null when the holder revoked it themselves.
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason")

  createdFromIp String?  @map("created_from_ip")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("api_keys")
}

/// One instrument, as this venue names it.
///
/// The platform trades `XAUUSD`; a venue may call it `XAUUSD.m`, `GOLD` or
/// `XAU/USD`, with its own lot step and price precision. Nothing guesses: an
/// instrument with no mapping on a connection cannot be traded through it,
/// and the refusal names what is missing.
model BrokerInstrumentMapping {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  symbolId     String @map("symbol_id") @db.Uuid

  /// What the venue calls it.
  externalSymbol String   @map("external_symbol")
  /// The venue's own terms, as it reported them. Read to refuse an order the
  /// venue would reject anyway, and to notice when the venue changes them.
  contractSize   Decimal? @map("contract_size") @db.Decimal(28, 10)
  volumeStep     Decimal? @map("volume_step") @db.Decimal(18, 8)
  minVolume      Decimal? @map("min_volume") @db.Decimal(18, 8)
  maxVolume      Decimal? @map("max_volume") @db.Decimal(18, 8)
  priceDecimals  Int?     @map("price_decimals")

  enabled Boolean @default(true)

  /// When the venue's own catalogue was last read into this row.
  syncedAt  DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  symbol     Symbol           @relation(fields: [symbolId], references: [id], onDelete: Restrict)

  @@unique([connectionId, symbolId])
  @@unique([connectionId, externalSymbol])
  @@index([tenantId])
  @@map("broker_instrument_mappings")
}

/// A domain event, written in the same transaction as the change it describes.
///
/// The transactional outbox: a subscriber is told about a fill if and only if
/// the fill committed. Publishing inside the transaction would announce one a
/// rollback is about to erase; publishing after it would lose the
/// announcement if the process died in between. The row is the promise; the
/// worker keeps it.
///
/// The envelope is v2 (docs/websocket.md), so the same shape reaches a socket,
/// this table, and later a webhook.
model OutboxEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The event's own id, as the envelope carries it. Unique: a relay that ran
  /// twice must not produce two events.
  eventId       String  @unique @map("event_id")
  eventType     String  @map("event_type")
  aggregateType String  @map("aggregate_type")
  aggregateId   String  @map("aggregate_id")
  accountId     String? @map("account_id") @db.Uuid
  actorId       String? @map("actor_id") @db.Uuid
  correlationId String? @map("correlation_id")
  causationId   String? @map("causation_id")
  payload       Json

  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  /// When the relay may next try. Backoff lives here rather than in a queue so
  /// a restart cannot lose it.
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  relayedAt     DateTime?    @map("relayed_at") @db.Timestamptz(6)

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  RELAYED
  /// Tried enough times to stop trying. A person looks; nothing is discarded.
  ABANDONED
}

/// Something a venue told us, recorded before it is acted on.
///
/// The inbox. A venue redelivers, delivers late, and delivers out of order —
/// all three are normal, none is an error. `externalEventId` unique per
/// connection is the dedupe; `sequence` is the ordering; the raw payload is
/// kept so an event can be replayed against corrected code without asking the
/// venue for it again.
///
/// Recording is separate from applying on purpose: an event that arrives
/// while the platform cannot make sense of it is still evidence, and a
/// discrepancy investigated a week later needs what the venue actually said.
model BrokerInboundEvent {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  externalEventId   String  @map("external_event_id")
  sequence          BigInt?
  kind              String
  externalAccountId String? @map("external_account_id")
  payload           Json

  status     InboundStatus @default(PENDING)
  attempts   Int           @default(0)
  lastError  String?       @map("last_error")
  appliedAt  DateTime?     @map("applied_at") @db.Timestamptz(6)
  /// Why it was skipped, when it was: an event about an account we do not
  /// map, a kind this build does not handle.
  skipReason String?       @map("skip_reason")

  /// When the venue says it happened, and when we heard.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  connection BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, externalEventId])
  @@index([status, receivedAt])
  @@index([connectionId, sequence])
  @@index([tenantId])
  @@map("broker_inbound_events")
}

enum InboundStatus {
  PENDING
  APPLIED
  SKIPPED
  FAILED
}

/// A firm's link to a venue: which connector, how it is doing, and what the
/// venue said it can do. The credentials live beside it, sealed. The
/// connector itself is code in `@tp/broker-sdk`'s registry; this row names it.
/// See docs/broker-integration.md.
model BrokerConnection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// What the panel shows. Unique per tenant.
  name        String
  /// The connector's `kind` in the SDK registry, e.g. MOCK.
  adapterKind String @map("adapter_kind")
  /// Connector-specific, non-secret settings: endpoints, environment, account ids.
  settings    Json   @default("{}")

  enabled Boolean @default(true)

  /// The monitor's last verdict and the figures it was made from.
  status              BrokerConnectionStatus @default(UNKNOWN)
  capabilities        Json?
  lastHeartbeatAt     DateTime?              @map("last_heartbeat_at") @db.Timestamptz(6)
  lastQuoteAt         DateTime?              @map("last_quote_at") @db.Timestamptz(6)
  lastOrderEventAt    DateTime?              @map("last_order_event_at") @db.Timestamptz(6)
  latencyMs           Int?                   @map("latency_ms")
  lastError           String?                @map("last_error")
  consecutiveFailures Int                    @default(0) @map("consecutive_failures")
  circuitOpenings     Int                    @default(0) @map("circuit_openings")
  circuitOpenUntil    DateTime?              @map("circuit_open_until") @db.Timestamptz(6)
  statusChangedAt     DateTime?              @map("status_changed_at") @db.Timestamptz(6)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  createdBy   User                      @relation("BrokerConnectionCreator", fields: [createdById], references: [id])
  credentials BrokerCredential[]
  accounts    Account[]
  mappings    BrokerInstrumentMapping[]
  inbound     BrokerInboundEvent[]

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("broker_connections")
}

enum BrokerConnectionStatus {
  UNKNOWN
  CONNECTING
  CONNECTED
  DEGRADED
  DISCONNECTED
  AUTH_FAILED
  RATE_LIMITED
}

/// A venue's credentials, sealed with SecretBox and bound to the connection.
/// Nothing that leaves the server carries a field value: the list shows the
/// kind, the fingerprint and the non-secret fields. Rotation is a new row
/// and the old one revoked, so who-used-what-when survives.
model BrokerCredential {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid

  kind        String
  /// SecretBox output over the serialised payload; context is the connection id.
  sealed      String
  /// SHA-256 prefix over the payload. Identifies without revealing.
  fingerprint String
  /// The non-secret fields, for the panel: login, server, key id.
  visible     Json   @default("{}")

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById String?   @map("revoked_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  connection BrokerConnection @relation(fields: [connectionId], references: [id])
  createdBy  User             @relation("BrokerCredentialCreator", fields: [createdById], references: [id])

  @@index([connectionId, revokedAt])
  @@index([tenantId])
  @@map("broker_credentials")
}

/// A machine identity that belongs to the firm rather than to a person, for an
/// integration that reads the platform. Carries only what
/// SERVICE_GRANTABLE_PERMISSIONS allows and only what its minter held.
model ServiceToken {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name               String
  description        String?
  /// `tps_<handle>`.
  fingerprint        String   @unique
  secretHash         String   @map("secret_hash")
  permissions        String[]
  rateLimitPerMinute Int      @map("rate_limit_per_minute")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp String?   @map("last_used_ip")

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("service_tokens")
}

enum CredentialKind {
  API_KEY
  SERVICE_TOKEN
}

/// One row per credential per day: how often it was presented, how often it
/// was refused a capability, how often it was throttled. Enough to answer "is
/// this key still used" and "is something hammering us with it" without a row
/// per request.
model CredentialUsage {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  kind         CredentialKind
  credentialId String         @map("credential_id") @db.Uuid
  day          DateTime       @db.Date
  requests     Int            @default(0)
  refused      Int            @default(0)
  throttled    Int            @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([kind, credentialId, day])
  @@index([tenantId])
  @@map("credential_usage")
}

/// Which process is allowed to run a singleton loop right now.
///
/// The trigger engine and the market feed must run in exactly one place. Until
/// now that was arranged by setting `TRIGGER_ENGINE_ENABLED` on one container
/// and hoping nobody scaled it — a convention, not a mechanism. Two engines
/// evaluating the same tick is not a performance problem: it is two stop-outs
/// on one position, and two fills for one resting order.
///
/// A row is a lease, not a flag. `expires_at` is written from the *database's*
/// clock, so every contender is judged against one clock rather than its own;
/// that removes the entire class of bug where a container with a skewed clock
/// believes it is still the leader. `term` increases on every takeover and
/// stays put across renewals, so a log line can tell "the same process has held
/// this for an hour" from "it has changed hands forty times".
///
/// Not tenant-scoped: leadership is a property of the deployment, not of a
/// tenant's data, and a tenant must never be able to see or take it.
model LeaderLease {
  /// The singleton being led, e.g. `trigger-engine`.
  name       String   @id
  /// Instance id of the holder — random per process boot, never reused.
  holder     String
  /// Fencing token. Bumped on takeover, unchanged by a renewal.
  term       BigInt   @default(1)
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)
  renewedAt  DateTime @default(now()) @map("renewed_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("leader_leases")
}

/// Which way the market has to move for a price alert to be worth sending.
enum PriceAlertCondition {
  ABOVE
  BELOW
}

/// Which half of the book an alert watches.
///
/// There is no single "price" for an instrument, and picking one silently is
/// how an alert fires at a number the trader never saw. `MID` is offered
/// because it is what most charts draw, but it is never a price anyone can deal
/// at — which is why `BID` is the default.
enum PriceAlertSource {
  BID
  ASK
  MID
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
  EXPIRED
}

/// "Tell me when gold reaches 4600."
///
/// Belongs to a person, not an account: a trader watching a level is watching
/// the market, and wants to hear about it whether or not they happen to hold a
/// position. An account may be named so the notification can say which one it
/// is about, and so it can be scoped in the console.
///
/// One alert fires once. A level crossed back and forth in a volatile minute
/// would otherwise produce a notification per oscillation, which is how a
/// trader learns to ignore them. Re-arming is the trader's decision, taken
/// deliberately, and the row records that it already fired.
model PriceAlert {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  symbol    String
  condition PriceAlertCondition
  source    PriceAlertSource    @default(BID)
  /// The level. NUMERIC, like every other price on the platform: a level a
  /// trader typed must be compared as they typed it, not as a float near it.
  price     Decimal             @db.Decimal(24, 10)

  status PriceAlertStatus @default(ACTIVE)
  /// Optional free text the trader wrote for themselves — "add here".
  note   String?

  /// After this, the alert stops watching. Null means it waits indefinitely.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  triggeredAt    DateTime? @map("triggered_at") @db.Timestamptz(6)
  /// The price as it stood when the alert fired — not the extreme that
  /// triggered it, which has already gone.
  triggeredPrice Decimal?  @map("triggered_price") @db.Decimal(24, 10)
  /// The notification this produced, so the two can be shown together.
  notificationId String?   @map("notification_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The evaluation sweep's only query: the active alerts on an instrument.
  /// Partial, because triggered alerts accumulate for ever and none of them is
  /// ever read by the thing that runs on every tick.
  @@index([symbol, status])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("price_alerts")
}

/// One thing this platform and a venue disagreed about (§44).
///
/// Only disagreements are stored. A matched order is a row the platform would
/// write on every run for the life of the account, and a hundred thousand of
/// them say exactly what `ReconciliationRun.itemsMatched` says in one integer.
/// So `MATCHED` is a status this column can hold and in practice never does —
/// kept in the enum because the comparison produces it and truncating the
/// vocabulary at the database boundary is how a status quietly becomes a lie.
///
/// Rows are per run, not deduplicated. A finding is deduplicated because it is
/// the *standing* view of a problem; an item is the record of one comparison at
/// one moment, and "the same order disagreed on Monday and again on Tuesday" is
/// two observations, which is precisely what an investigator wants to see.
///
/// **Nothing here repairs anything** (§112). A discrepancy is recorded and
/// alerted; correcting it is a deliberate, separate, audited act by a person,
/// and the act is a `ResolutionRecord`.
model ReconciliationItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  runId    String @map("run_id") @db.Uuid

  accountId          String  @map("account_id") @db.Uuid
  /// The venue this was compared against.
  brokerConnectionId String? @map("broker_connection_id") @db.Uuid

  subject ReconciliationSubject
  /// What both sides call this thing: a client order id, a position id, or the
  /// account number when the item is about the account's money.
  key     String
  status  ReconciliationItemStatus
  /// The field that disagreed. Null when the whole thing is missing on a side.
  field   String?

  /// Decimal strings, kept as text: these are evidence, not operands. Storing
  /// them as NUMERIC would invite arithmetic on a record of an inconsistency.
  internal   String?
  external   String?
  difference String?
  /// The tolerance applied, when one was — so a reader can tell "these agreed"
  /// from "these were close enough by a rule somebody set".
  tolerance  String?

  message String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run         ReconciliationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resolutions ResolutionRecord[]

  @@index([runId, status])
  @@index([accountId, subject, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("reconciliation_items")
}

/// What somebody decided about a discrepancy, and why.
///
/// Append-only, and separate from the item on purpose. An item's `status` is
/// what the machine observed; a resolution is what a person concluded, and the
/// two must not be able to overwrite each other. A discrepancy that was
/// investigated and found to be a venue rounding rule, and the same one
/// reopened a month later, are two records — not one field changing its mind.
///
/// There is no route that edits or deletes one. The correction of a mistaken
/// resolution is another resolution saying so.
model ResolutionRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Exactly one of these. An item is one observation; a finding is a standing
  /// internal inconsistency. Both get resolved, and by the same people.
  itemId    String? @map("item_id") @db.Uuid
  findingId String? @map("finding_id") @db.Uuid

  /// What was decided. Deliberately not an enum of outcomes that includes
  /// "repaired": nothing in this system repairs a discrepancy, so there is no
  /// value here that could claim it did.
  decision ResolutionDecision
  /// The person's own words. Required — a decision with no reason is a decision
  /// nobody can review, and these are read months later by people who were not
  /// there.
  note     String

  decidedByUserId String   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  item      ReconciliationItem?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  finding   ReconciliationFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  decidedBy User                   @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([itemId, decidedAt(sort: Desc)])
  @@index([findingId, decidedAt(sort: Desc)])
  @@index([tenantId])
  @@map("resolution_records")
}

enum ResolutionDecision {
  /// Looked at, and the records were right after all.
  FALSE_POSITIVE
  /// Real, understood, and expected to stay — a venue that rounds differently.
  ACCEPTED_DIFFERENCE
  /// Real, and a correcting entry was made elsewhere by hand. This records the
  /// decision; the correction itself is a ledger entry with its own audit.
  CORRECTED_MANUALLY
  /// Real, and the cause is being chased. Not a conclusion, a state.
  UNDER_INVESTIGATION
  /// Escalated beyond the desk — to the venue, or to whoever owns the money.
  ESCALATED
}

/// What an impersonation grant permits.
///
/// `READ_ONLY` is the only value this platform will create today, and the guard
/// refuses every non-GET request made under a grant regardless. `READ_WRITE`
/// exists in the type because §9 describes it and truncating the vocabulary at
/// the database boundary is how a column quietly becomes a lie — but a support
/// person placing a trade as a customer needs controls a firm has to decide on
/// (who approves, for how long, what is still forbidden), and inventing them
/// here would be inventing a policy nobody agreed to.
enum BreakGlassScope {
  READ_ONLY
  READ_WRITE
}

/// A member of staff, temporarily allowed to see what one trader sees (§9).
///
/// ## Why this is a grant and not a token
///
/// The obvious design is to mint an access token that says "you are the
/// trader". It is the wrong one. Every downstream check would then see the
/// trader, the audit trail would record the trader as the actor, and revoking
/// mid-session would mean chasing a token that has already been issued.
///
/// So the staff member stays themselves for the whole session and carries this
/// row instead. Revocation is an `UPDATE`. The audit trail always names the
/// person who actually did it. And "may this person see that person's data" is
/// a question asked per request against the database's clock, rather than a
/// claim minted fifteen minutes ago and trusted since.
///
/// ## What a grant can never do
///
/// It cannot cross tenants — a broker's staff cannot reach the platform's users
/// or another firm's traders. It cannot reach a subject who holds a permission
/// the actor does not, which is what stops an administrator from using support
/// tooling to become a super administrator. And it cannot outlive
/// `BREAK_GLASS_MAX_TTL_MS`; a grant is an errand, not a mode somebody leaves
/// switched on.
model BreakGlassGrant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The member of staff. Always the actor in every audit row written under it.
  actorId       String @map("actor_id") @db.Uuid
  /// Whose data may be seen.
  subjectUserId String @map("subject_user_id") @db.Uuid

  /// Why. Required, and the database refuses a blank one — a break-glass with
  /// no reason is the access nobody can review afterwards, which is the only
  /// thing that makes this safe to have at all.
  reason String
  scope  BreakGlassScope @default(READ_ONLY)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Set when somebody ends it early. A grant that has been used and closed is
  /// a different record from one that ran out, and an investigator wants both.
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  endedByUserId String?   @map("ended_by_user_id") @db.Uuid

  /// How many requests were served under it. Zero means it was opened and never
  /// used, which is worth being able to see.
  uses Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor   User @relation("BreakGlassActor", fields: [actorId], references: [id], onDelete: Restrict)
  subject User @relation("BreakGlassSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The sweep's query: this person's live grants.
  @@index([actorId, expiresAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
  @@index([tenantId])
  @@map("break_glass_grants")
}
